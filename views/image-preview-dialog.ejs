<dialog id="imagePreviewDialog" class="image-preview-dialog" aria-label="Image preview">
  <div class="image-preview-toolbar" role="group" aria-label="Image zoom controls">
    <button type="button" class="ghost" id="imageZoomOut" aria-label="Zoom out" disabled>−</button>
    <button type="button" class="ghost" id="imageZoomReset" aria-label="Reset image zoom" disabled>100%</button>
    <button type="button" class="ghost" id="imageZoomIn" aria-label="Zoom in" disabled>+</button>
    <a id="imagePreviewTradingView" class="ghost" target="_blank" rel="noopener noreferrer" hidden>VIEW IN TRADINGVIEW</a>
    <form method="dialog" class="dialog-close-form">
      <button type="submit" class="ghost image-preview-close" aria-label="Close image preview">CLOSE ✕</button>
    </form>
  </div>
  <p id="imagePreviewStatus" class="image-preview-status" role="status">Loading image preview…</p>
  <div class="image-preview-viewport" id="imagePreviewViewport" tabindex="0" aria-label="Image preview; drag or use arrow keys to move around the zoomed image" hidden>
    <img id="imagePreviewFull" alt="Full-size image preview" draggable="false" hidden>
  </div>
</dialog>
