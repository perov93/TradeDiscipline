<% const record=item.record, isJournal=item.isJournal, standalone=typeof libraryPage!=='undefined' && libraryPage;
   const images=record.images && record.images.length ? record.images : (record.imageId ? [{id:record.imageId}] : []);
   const videos=record.videos || [];
   const imageRoot=isJournal?'/trades/':'/setups/';
   const videoRoot=imageRoot;
   const outcomeTone=record.outcome==='WIN'?'win':record.outcome==='LOSS'?'loss':'even'; %>
<details class="setup-record" <%= typeof selectedSetup!=='undefined' && selectedSetup && !isJournal && String(selectedSetup._id)===String(record._id)?'open':'' %>>
  <summary class="recent-trade-row">
    <span class="recent-trade-time"><%= record.tradeTime || timeKey(record.createdAt,user.timezone) %></span>
    <span class="recent-trade-name">
      <%= isJournal ? (record.instrument || 'Trade') : record.title %>
      <% if(record.side){ %><span class="recent-trade-side <%= record.side==='SELL'?'pnl-neg':'pnl-pos' %>"><%= record.side %></span><% } %>
      <span class="recent-trade-sub"><%= record.strategy ? record.strategy+' · ' : '' %><%= isJournal?'JOURNAL TRADE':'SAVED EXAMPLE' %></span>
    </span>
    <% if(standalone){ %>
      <span class="setup-library-side <%= record.side==='SELL'?'pnl-neg':record.side==='BUY'?'pnl-pos':'' %>" aria-label="Side: <%= record.side || 'not recorded' %>"><%= record.side || '—' %></span>
      <span class="setup-library-instrument" aria-label="Instrument: <%= record.instrument || 'not recorded' %>"><%= record.instrument || '—' %></span>
      <span class="setup-library-session" aria-label="Session: <%= record.session || 'not recorded' %>"><%= record.session || '—' %></span>
      <span class="setup-library-strategy" aria-label="Strategy: <%= record.strategy || 'not recorded' %>"><%= record.strategy || '—' %></span>
      <span class="setup-record-outcome setup-record-outcome-<%= outcomeTone %>"><%= record.outcome %></span>
      <span class="recent-trade-amount <%= pnlClass(record.pnl) %>" <% if(record.pnl == null && !isJournal){ %>aria-label="P&amp;L not recorded"<% } %>><%= record.pnl == null && !isJournal ? '—' : fmtPnl(record.pnl,record.currency) %></span>
      <span class="setup-record-chevron" aria-hidden="true">⌄</span>
    <% }else{ %>
      <span class="setup-record-trailing">
        <span class="setup-record-result">
          <% if(record.pnl != null || isJournal){ %><span class="recent-trade-amount <%= pnlClass(record.pnl) %>"><%= fmtPnl(record.pnl,record.currency) %></span><% } %>
          <span class="setup-record-outcome setup-record-outcome-<%= outcomeTone %>"><%= record.outcome %></span>
        </span>
        <span class="setup-record-chevron" aria-hidden="true">⌄</span>
      </span>
    <% } %>
  </summary>
  <div class="setup-record-detail">
    <div class="setup-record-info">
    <div class="record-chips">
      <span class="record-chip <%= outcomeTone==='win'?'record-chip-good':outcomeTone==='loss'?'record-chip-bad':'' %>"><%= record.outcome %></span>
      <span class="record-chip"><%= record.instrument || 'Instrument not specified' %></span>
      <% if(record.side){ %><span class="record-chip <%= record.side==='SELL'?'record-chip-bad':'record-chip-good' %>"><%= record.side %></span><% } %>
      <span class="record-chip"><%= record.session || 'Session not recorded' %></span>
      <% if(record.account){ %><span class="record-chip"><%= record.account %></span><% } %>
      <% if(isJournal || record.accountCount != null){ %><span class="record-chip"><%= record.accountCount || 1 %> account(s)</span><% } %>
      <span class="record-chip"><%= record.currency || 'USD' %></span>
    </div>
    <% if(isJournal || record.emotion != null || typeof record.followedPlan==='boolean'){ %>
      <p><%= record.emotion || 'Emotion not recorded' %> · <%= record.followedPlan===true?'Plan followed':record.followedPlan===false?'Plan broken':'Plan status unknown' %></p>
    <% } %>
    <% if(record.planDeviationReason){ %><p>Plan deviation: <%= record.planDeviationReason %></p><% } %>
    <% if(record.notes){ %>
      <div class="record-note setup-record-note">
        <span class="record-label">LESSON / NOTES</span>
        <p><%= record.notes %></p>
      </div>
    <% } %>
    </div>
    <div class="record-images">
      <% images.forEach((image,index)=>{ const src=imageRoot+record._id+'/images/'+image.id; %>
        <button type="button" class="image-preview-trigger" data-image-src="<%= src %>" aria-label="Preview image <%= index+1 %>"><img src="<%= src %>" alt="Record image <%= index+1 %>" loading="lazy"></button>
      <% }) %>
      <% videos.forEach((video,index)=>{ const src=videoRoot+record._id+'/videos/'+video.id; %>
        <button type="button" class="video-preview-trigger" data-video-preview data-video-src="<%= src %>" data-video-mime="<%= video.mime %>" aria-label="Preview video <%= index+1 %>">
          <span class="video-preview-play" aria-hidden="true"></span><span class="video-preview-label">VIDEO <%= index+1 %></span>
        </button>
      <% }) %>
      <% if(record.tradingViewId && /^[a-z0-9]{8}$/i.test(record.tradingViewId)){ const snapshot='https://s3.tradingview.com/snapshots/'+record.tradingViewId[0].toLowerCase()+'/'+record.tradingViewId+'.png'; %>
        <button type="button" class="image-preview-trigger" data-image-src="<%= snapshot %>" data-trading-view-id="<%= record.tradingViewId %>" aria-label="Preview TradingView snapshot"><img src="<%= snapshot %>" alt="TradingView snapshot" loading="lazy"></button>
      <% } %>
    </div>
    <% if(standalone){ %>
      <div class="journal-actions">
        <% if(isJournal){ %>
          <a class="textbutton" href="/?calendarDate=<%= encodeURIComponent(date) %>#calendar">OPEN TRADE IN CALENDAR</a>
        <% }else{ %>
          <a class="textbutton" href="/?setupId=<%= encodeURIComponent(String(record._id)) %>#setups">EDIT EXAMPLE</a>
          <button type="button" class="textbutton danger-text" aria-haspopup="dialog" aria-controls="setupDeleteDialog"
            data-setup-delete="/setups/<%= record._id %>/delete" data-setup-title="<%= record.title %>">DELETE EXAMPLE</button>
        <% } %>
      </div>
    <% }else if(isJournal){ %>
      <div class="journal-actions">
        <button type="button" class="textbutton trade-edit-trigger" data-trade-id="<%= record._id %>" data-return-to="setups">EDIT TRADE</button>
        <a class="textbutton" href="/?calendarDate=<%= encodeURIComponent(date) %>#calendar">OPEN IN CALENDAR</a>
      </div>
    <% }else{ %>
      <div class="journal-actions">
        <button type="button" class="textbutton" data-edit-dialog="setupEditDialog<%= record._id %>" aria-haspopup="dialog" aria-controls="setupEditDialog<%= record._id %>">EDIT EXAMPLE</button>
        <button type="button" class="textbutton danger-text" aria-haspopup="dialog" aria-controls="setupDeleteDialog"
          data-setup-delete="/setups/<%= record._id %>/delete" data-setup-title="<%= record.title %>">DELETE EXAMPLE</button>
      </div>
    <% } %>
  </div>
</details>
<% if(!standalone && !isJournal){ %>
  <dialog id="setupEditDialog<%= record._id %>" class="rule-dialog trade-dialog" aria-labelledby="setupEditTitle<%= record._id %>" data-record-editor data-open-on-load="<%= typeof selectedSetup!=='undefined' && selectedSetup && String(selectedSetup._id)===String(record._id)?'true':'false' %>">
    <div class="rule-dialog-head">
      <div>
        <div class="eyebrow">A+ SETUPS / SAVED EXAMPLE</div>
        <h2 id="setupEditTitle<%= record._id %>">EDIT EXAMPLE</h2>
      </div>
      <form method="dialog" class="dialog-close-form">
        <button type="submit" class="rule-dialog-close ghost" aria-label="Close dialog">✕</button>
      </form>
    </div>
    <%- include('setup-form', {setup:record,preferences}) %>
  </dialog>
<% } %>
