            <div>
              <h2>MONTH BY MONTH</h2>
              <p id="calendarYearCaption" class="micro"></p>
            </div>
            <div class="calendar-controls">
              <label class="calendar-currency-label">CURRENCY
                <select id="calendarCurrency" aria-label="Calendar currency"></select>
              </label>
              <div id="calendarYears" class="calendar-years" role="group" aria-label="Calendar year"></div>
            </div>
          </div>
          <div id="monthlyPerformance" class="monthly-performance" role="group" aria-label="Monthly profit and loss; select a month"></div>
