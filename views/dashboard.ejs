                <button type="button" class="outline" id="nextMonth" aria-label="Next month">›</button>
              </div>
              <div class="calendar-month-label">NET RESULT · <span id="calendarMonthCurrency"></span></div>
              <div id="monthPnl" class="month-pnl"></div>
              <div id="calendarMonthStats" class="calendar-month-stats"></div>
              <p class="micro">Select a date to review trades and no-setup entries. No setup means no trade, not a break-even result. All dates use your account timezone.</p>
            </aside>
            <div class="calendar-scroll" tabindex="0" role="region" aria-label="Daily results and weekly totals">
              <div id="calendarGrid" class="calendar" data-timezone="<%= user.timezone %>" data-today="<%= today %>" data-csrf="<%= csrf %>" data-default-currency="<%= preferences.calendarCurrency %>" data-analysis-range="<%= preferences.analysisRange %>"></div>
            </div>
          </div>
          </section>
          <section class="cal-block cal-day" aria-label="Day records">
            <h3 class="cal-title"><span>DAY RECORDS</span><small>Click a day above</small></h3>
            <div id="selectedDay" class="day-summary">Select a day in the calendar to review its trades.</div>
          </section>
          <details class="calendar-month-table calendar-disclosure">
            <summary><span>All months</span><em>Results for every month of a year</em></summary>
            <div class="calendar-month-table-body">
              <div class="calendar-table-toolbar">
                <div>
                  <span class="day-records-kicker">YEARLY PERFORMANCE</span>
                  <p class="micro">Select a month to review its calendar and trades.</p>
                </div>
                <label class="calendar-table-year">YEAR
                  <select id="calendarTableYear" aria-label="Monthly table year"></select>
                </label>
              </div>
              <div class="calendar-table-scroll" tabindex="0" role="region" aria-label="Monthly results and yearly totals">
                <table>
                  <caption id="calendarMonthTableCaption"></caption>
                  <thead><tr><th scope="col">Month</th><th scope="col">Trades</th><th scope="col">Win rate</th><th scope="col">Net P&amp;L</th></tr></thead>
                  <tbody id="calendarMonthRows"></tbody>
                  <tfoot><tr><th scope="row">Year total</th><td id="calendarYearTrades"></td><td id="calendarYearWinRate"></td><td id="calendarYearPnl"></td></tr></tfoot>
                </table>
              </div>
              <section id="calendarMonthTrades" class="calendar-month-trades" aria-labelledby="calendarMonthTradesTitle" hidden>
                <h3 id="calendarMonthTradesTitle"></h3>
                <p class="micro">Select a trade date to open that day's records.</p>
                <div class="calendar-table-scroll" tabindex="0" role="region" aria-label="Selected month trade records">
                  <table>
                    <thead><tr><th scope="col">Date / time</th><th scope="col">Instrument</th><th scope="col">Side</th><th scope="col">Strategy</th><th scope="col">Outcome</th><th scope="col">P&amp;L</th></tr></thead>
                    <tbody id="calendarMonthTradeRows" aria-live="polite"></tbody>
                  </table>
                </div>
              </section>
            </div>
          </details>
          <details class="calendar-analysis-details calendar-disclosure">
            <summary><span>Day &amp; period overview</span><em>Stats, charts and streaks for a period</em></summary>
          <section class="calendar-analysis" aria-labelledby="analysisTitle">
            <div class="analysis-heading">
              <div>
                <h2 id="analysisTitle">PERFORMANCE ANALYSIS</h2>
                <p id="analysisPeriodLabel">Selected month</p>
              </div>
              <div class="analysis-controls">
                <div class="analysis-periods" role="group" aria-label="Analysis period">
                <button type="button" class="analysis-period" data-analysis-range="day" aria-pressed="false">DAY</button>
                <button type="button" class="analysis-period is-selected" data-analysis-range="month" aria-pressed="true">MONTH</button>
                <button type="button" class="analysis-period" data-analysis-range="7d" aria-pressed="false">7 DAYS</button>
                <button type="button" class="analysis-period" data-analysis-range="30d" aria-pressed="false">30 DAYS</button>
                <button type="button" class="analysis-period" data-analysis-range="all" aria-pressed="false">ALL TIME</button>
                </div>
                <label class="analysis-currency-label">STATS &amp; CHART CURRENCY
                  <select id="analysisCurrency" aria-label="Statistics and chart currency" disabled></select>
                </label>
              </div>
            </div>
            <div class="analysis-tabs" role="tablist" aria-label="Overview sections">
              <button type="button" id="analysisTabSummary" class="analysis-tab is-selected" role="tab" aria-selected="true" aria-controls="analysisPaneSummary" data-analysis-pane="summary">SUMMARY</button>
              <button type="button" id="analysisTabStats" class="analysis-tab" role="tab" aria-selected="false" aria-controls="analysisPaneStats" tabindex="-1" data-analysis-pane="stats">ACCOUNT IN NUMBERS</button>
              <button type="button" id="analysisTabCharts" class="analysis-tab" role="tab" aria-selected="false" aria-controls="analysisPaneCharts" tabindex="-1" data-analysis-pane="charts">CHARTS</button>
            </div>
            <div id="analysisPaneSummary" class="analysis-pane" role="tabpanel" aria-labelledby="analysisTabSummary" data-pane="summary">
              <div class="analysis-metrics">
              <article class="analysis-metric"><span>TRADES</span><strong id="analysisTradeCount">0</strong></article>
              <article class="analysis-metric"><span>NO-SETUP ENTRIES</span><strong id="analysisNoSetupCount">0</strong></article>
              <article class="analysis-metric"><span>WIN RATE</span><strong id="analysisWinRate">—</strong></article>
              <article class="analysis-metric"><span>PLAN FOLLOWED</span><strong id="analysisPlanRate">—</strong></article>
              <article class="analysis-metric analysis-net"><span>NET P&amp;L · BY CURRENCY</span><div id="analysisNetPnl"></div></article>
            </div>
              <section class="strategy-analysis" aria-labelledby="strategyAnalysisTitle">
              <div class="analysis-chart-heading">
                <div>
                  <h3 id="strategyAnalysisTitle">STRATEGY WIN RATE</h3>
                  <p id="strategyAnalysisCaption"></p>
                </div>
              </div>
              <div id="strategyAnalysis" class="strategy-analysis-list"></div>
            </section>
              <section class="streak-analysis" aria-label="Winning and losing streaks">
              <article class="streak-card streak-win">
                <span>WIN STREAK</span>
                <div><strong id="currentWinStreak">0</strong><small>current</small></div>
                <div><strong id="bestWinStreak">0</strong><small>best in period</small></div>
              </article>
              <article class="streak-card streak-loss">
                <span>LOSS STREAK</span>
                <div><strong id="currentLossStreak">0</strong><small>current</small></div>
                <div><strong id="worstLossStreak">0</strong><small>worst in period</small></div>
              </article>
            </section>
            </div>
            <div id="analysisPaneStats" class="analysis-pane" role="tabpanel" aria-labelledby="analysisTabStats" data-pane="stats" hidden>
              <section class="performance-stats" aria-labelledby="performanceStatsTitle">
              <div class="analysis-chart-heading">
                <div>
                  <h3 id="performanceStatsTitle">ACCOUNT IN NUMBERS</h3>
                  <p id="performanceStatsCaption"></p>
                </div>
              </div>
              <div id="performanceStats"></div>
            </section>
            </div>
            <div id="analysisPaneCharts" class="analysis-pane" role="tabpanel" aria-labelledby="analysisTabCharts" data-pane="charts" hidden>
              <div class="analysis-charts">
              <section class="analysis-chart-card" aria-labelledby="equityChartTitle">
                <div class="analysis-chart-heading">
                  <div>
                    <h3 id="equityChartTitle">CUMULATIVE P&amp;L</h3>
                    <p id="equityChartCaption">Choose a currency to view performance.</p>
                  </div>
                </div>
                <svg id="equityChart" class="equity-chart" viewBox="0 0 760 240" role="img" aria-label="Cumulative profit and loss chart"></svg>
                <p class="analysis-empty" id="equityChartEmpty" hidden>No trades in this period.</p>
              </section>
              <section class="analysis-chart-card outcome-card" aria-labelledby="outcomeChartTitle">
                <h3 id="outcomeChartTitle">TRADE OUTCOMES</h3>
                <p class="analysis-chart-subtitle">Results in this period</p>
                <div class="outcome-breakdown" id="outcomeBreakdown"></div>
              </section>
            </div>
              <section class="daily-analysis" aria-labelledby="dailyAnalysisTitle">
              <div class="analysis-chart-heading">
                <div>
                  <h3 id="dailyAnalysisTitle">DAY-BY-DAY RESULTS</h3>
                  <p id="dailyAnalysisCaption">Daily net result in selected currency.</p>
                </div>
              </div>
              <div class="daily-bars" id="dailyBars" role="list" aria-label="Daily profit and loss"></div>
            </section>
            </div>
            <details class="analysis-notes">
              <summary>How these numbers are calculated</summary>
              <ul>
                <li>Win rate = wins ÷ (wins + losses). Break-even trades are excluded, and a break-even resets a streak.</li>
                <li>Plan followed excludes records where the plan status was not recorded.</li>
                <li>No-setup entries are counted separately from trades, in all currencies.</li>
                <li>Statistics and charts use one currency at a time. P&amp;L is never converted or combined.</li>
                <li>Average win/loss and profit factor use signed P&amp;L. Monthly averages include recorded months only.</li>
                <li>Drawdown is realized cumulative P&amp;L from zero, not account equity. Percentage returns need balance history, so they are not calculated.</li>
                <li>Commissions and volume are not collected.</li>
              </ul>
            </details>
          </section>
          </details>
          <div class="calendar-legend" aria-label="Colour legend"><span class="lg-pos">Positive</span><span class="lg-neg">Negative</span><span class="lg-be">Break-even</span><small>One currency at a time, no conversion.</small></div>
        </section>
      </section>

      <section class="dashboard-tabpanel" id="settings" role="tabpanel" aria-labelledby="tab-settings" hidden>
        <% const pending=user.pendingSettings; const editable=pending || user; %>
        <% if (!settingsReady) { %>
          <p class="notice warning">Restart the app server to enable saving settings. Your existing data is unchanged.</p>
        <% } %>
        <section class="panel">
          <div class="section-heading"><span>YOUR SETTINGS</span><span class="tag">PRIVATE TO YOUR ACCOUNT</span></div>
          <p class="muted small">Manage your profile, discipline, journal and dashboard. Changes affect only your account. Existing trade currencies and dates are not rewritten.</p>
          <% if (pending) { %>
            <p class="notice warning">Pending discipline and timezone changes take effect at <%= new Intl.DateTimeFormat('en-GB',{timeZone:user.timezone,dateStyle:'medium',timeStyle:'short'}).format(pending.effectiveAt) %> (<%= user.timezone %>). Until then: <%= user.limits.maxTrades %> trades, <%= user.limits.maxLosses %> losses, <%= user.limits.cooldownMinutes %> minute cooldown. Saving the current active values cancels pending changes.</p>
          <% } %>
          <form method="post" action="/settings" class="journal-form settings-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>PROFILE</legend>
              <label>DISPLAY NAME<input name="name" value="<%= user.name %>" minlength="2" maxlength="80" autocomplete="name" required></label>
              <p class="micro">Signed in as <%= user.email %>. Your login email is not changed here.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>PERSONAL MOTIVATION</legend>
              <label>YOUR DASHBOARD MESSAGE
                <textarea name="motivationalMessage" maxlength="500" rows="3" placeholder="Write a reminder that helps you stay focused and disciplined."><%= preferences.motivationalMessage %></textarea>
              </label>
              <label class="inline-check"><input type="checkbox" name="showMotivationalMessage" <%= preferences.showMotivationalMessage?'checked':'' %>> SHOW MOTIVATIONAL MESSAGE ON DASHBOARD</label>
              <p class="micro">Only you can see this message. Hiding it keeps your text saved; clearing it restores the starter reminder.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>DISCIPLINE</legend>
              <div class="settings-fields">
                <label>MAX TRADES PER DAY<input type="number" name="maxTrades" value="<%= editable.limits.maxTrades %>" min="1" max="100" step="1" required></label>
                <label>MAX LOSSES PER DAY<input type="number" name="maxLosses" value="<%= editable.limits.maxLosses %>" min="1" max="100" step="1" required></label>
                <label>COOLDOWN AFTER A LOSS (MINUTES)<input type="number" name="cooldownMinutes" value="<%= editable.limits.cooldownMinutes %>" min="1" max="240" step="1" required></label>
              </div>
              <p class="micro">Discipline and timezone changes are scheduled for the next midnight in your current account timezone. Saving settings never clears today's emergency stop or an active cooldown. Zero / unlimited limits are not supported.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>REGIONAL &amp; JOURNAL</legend>
              <div class="settings-fields">
                <label>ACCOUNT TIMEZONE
                  <select name="timezone" required>
                    <% [...new Set([editable.timezone,...(settingsReady?settingsTimezones:Intl.supportedValuesOf('timeZone'))])].sort().forEach(zone=>{ %>
                      <option value="<%= zone %>" <%= editable.timezone===zone?'selected':'' %>><%= zone %></option>
                    <% }) %>
                  </select>
                </label>
                <label>DEFAULT JOURNAL CURRENCY
                  <select name="defaultCurrency" required>
                    <% (settingsReady?settingsCurrencies:Intl.supportedValuesOf('currency')).forEach(currency=>{ %>
                      <option value="<%= currency %>" <%= preferences.defaultCurrency===currency?'selected':'' %>><%= currency %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <p class="micro">The account timezone controls daily limits and calendar grouping. Forex schedules stay in Sofia time. Default currency is used for new records only; no currency conversion occurs.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>DASHBOARD</legend>
              <label>DEFAULT TAB
                <select name="defaultTab">
                  <% [['trading','Trade'],['journal','Journal'],['calendar','Calendar'],['rules','Rules'],['settings','Settings']].forEach(([value,label])=>{ %>
                    <option value="<%= value %>" <%= preferences.defaultTab===value?'selected':'' %>><%= label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="inline-check"><input type="checkbox" name="showWorldClocks" <%= preferences.showWorldClocks?'checked':'' %>> SHOW WORLD CLOCKS</label>
              <label class="inline-check"><input type="checkbox" name="showForexHours" <%= preferences.showForexHours?'checked':'' %>> SHOW FOREX HOURS &amp; TIMERS</label>
              <label class="inline-check"><input type="checkbox" name="showNyReminder" <%= preferences.showNyReminder?'checked':'' %>> SHOW NEW YORK SESSION REMINDER</label>
              <label class="inline-check"><input type="checkbox" name="showEconomicCalendar" <%= preferences.showEconomicCalendar?'checked':'' %>> SHOW ECONOMIC CALENDAR</label>
              <p class="micro">The default tab applies when no tab is specified in the URL. Hiding a widget does not disable trading safeguards.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>CALENDAR</legend>
              <div class="settings-fields">
                <label>DEFAULT CALENDAR CURRENCY
                  <select name="calendarCurrency">
                    <% (settingsReady?settingsCurrencies:Intl.supportedValuesOf('currency')).forEach(currency=>{ %>
                      <option value="<%= currency %>" <%= preferences.calendarCurrency===currency?'selected':'' %>><%= currency %></option>
                    <% }) %>
                  </select>
                </label>
                <label>DEFAULT ANALYSIS PERIOD
                  <select name="analysisRange">
                    <% [['month','Selected month'],['7d','Last 7 days'],['30d','Last 30 days'],['all','All time']].forEach(([value,label])=>{ %>
                      <option value="<%= value %>" <%= preferences.analysisRange===value?'selected':'' %>><%= label %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <p class="micro">Selections made inside the calendar are temporary. Save defaults here to keep them across visits.</p>
            </fieldset>
            <button type="submit" class="primary" <%= settingsReady?'':'disabled' %>>SAVE MY SETTINGS</button>
          </form>
        </section>
        <section class="panel">
          <div class="section-heading"><span>SECURITY / CHANGE PASSWORD</span></div>
          <form method="post" action="/settings/password" class="journal-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label>CURRENT PASSWORD<input type="password" name="currentPassword" autocomplete="current-password" <%= settingsReady?'':'disabled' %> required></label>
            <label>NEW PASSWORD<input type="password" name="newPassword" minlength="10" maxlength="128" autocomplete="new-password" <%= settingsReady?'':'disabled' %> required></label>
            <label>CONFIRM NEW PASSWORD<input type="password" name="confirmPassword" minlength="10" maxlength="128" autocomplete="new-password" <%= settingsReady?'':'disabled' %> required></label>
            <p class="micro">Use 10–128 characters (at most 72 UTF-8 bytes). Changing your password renews this browser's session; other signed-in sessions remain active.</p>
            <button type="submit" class="outline" <%= settingsReady?'':'disabled' %>>CHANGE PASSWORD</button>
          </form>
        </section>
        <section class="panel">
          <div class="section-heading"><span>RULES &amp; DATA</span></div>
          <p class="muted small">Manage your personal checklist in the Rules tab. Download your journal using CSV export. Notion synchronization is not connected yet.</p>
          <div class="actions">
            <a class="outline" href="#rules" data-tab-target="rules">MANAGE RULES</a>
            <a class="outline" href="/export">EXPORT MY JOURNAL</a>
          </div>
        </section>
      </section>

      <footer>
        DISCIPLINE · MY RULES. MY EDGE.<br>
        <span>Personal discipline tool, not a broker-level trading lock.</span>
      </footer>
    </main>
    <script id="trade-data" type="application/json"><%- JSON.stringify(trades.map(t => ({id: String(t._id), date: dayKey(t.createdAt, user.timezone), createdAt: t.createdAt.toISOString(), tradeTime: t.tradeTime || timeKey(t.createdAt, user.timezone), account: t.account || '', accountCount: Number(t.accountCount)||1, session: t.session || '', checklistCompleted: t.checklistCompleted ?? null, planDeviationReason: t.planDeviationReason || '', instrument: t.instrument, side: t.side, strategy: t.strategy || '', outcome: t.outcome, pnl: t.pnl, currency: t.currency || 'USD', emotion: t.emotion, followedPlan: t.followedPlan ?? null, notes: t.notes, tradingViewId: t.tradingViewId || '', images: t.images && t.images.length ? t.images.map(image => image.id) : (t.imageId ? [t.imageId] : [])}))).replace(/</g, '\\u003c') %></script>
    <script id="no-setup-data" type="application/json"><%- JSON.stringify(noSetupRecords.map(entry => ({id:String(entry._id),date:entry.date,notes:entry.notes}))).replace(/</g, '\\u003c') %></script>
  </body>
</html>
