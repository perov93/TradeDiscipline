          <div class="form-row">
            <label>TRADING SESSION
              <select name="session" id="tradeSession">
                <option value="">Not recorded</option>
                <% sessionChoices.filter(choice => choice !== 'auto').forEach(choice => { %>
                  <option value="<%= choice %>"><%= choice %></option>
                <% }) %>
              </select>
            </label>
            <label>TRADE ENTRY TIME (<%= user.timezone %>)<input type="time" name="tradeTime" id="tradeTime" required></label>
          </div>
          <div class="form-row">
            <label>INSTRUMENT<input name="instrument" id="tradeInstrument" maxlength="40"></label>
            <label>DIRECTION
              <select name="side" id="tradeSide">
                <option value="">Not specified</option>
                <option>BUY</option>
                <option>SELL</option>
              </select>
            </label>
          </div>
          <div class="form-row">
            <label>OUTCOME
              <select name="outcome" id="tradeOutcome" required>
                <option>WIN</option>
                <option>LOSS</option>
                <option>BREAKEVEN</option>
              </select>
            </label>
            <label>COMBINED P&amp;L<input name="pnl" id="tradePnl" type="number" step="0.01" required></label>
          </div>
          <p class="micro">Combined result across accounts; approximate per-account P&amp;L assumes an even split.</p>
          <p class="micro outcome-pnl-warning" data-outcome-pnl-warning role="status" hidden></p>
          <label>CURRENCY CODE<input name="currency" id="tradeCurrency" maxlength="3" minlength="3" pattern="[A-Za-z]{3}" required autocomplete="off"></label>
          <label>STRATEGY<input name="strategy" id="tradeStrategy" maxlength="120" placeholder="e.g. NY open breakout, pullback"></label>
          <label>EMOTION
            <select name="emotion" id="tradeEmotion">
              <option value="calm">Calm</option>
              <option value="fomo">FOMO</option>
              <option value="revenge">Revenge impulse</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>PLAN FOLLOWED
            <select name="followedPlan" id="tradeFollowedPlan">
              <option value="yes">Yes</option>
              <option value="no">No</option>
              <option value="unknown">Not recorded</option>
            </select>
          </label>
          <label id="tradePlanDeviationField" data-plan-deviation>WHY DIDN'T YOU FOLLOW YOUR PLAN?
            <textarea name="planDeviationReason" id="tradePlanDeviationReason" maxlength="500" rows="2" placeholder="Briefly explain what happened."></textarea>
          </label>
          <p id="tradeChecklistStatus" class="micro"></p>
          <label>LESSON / NOTES<textarea name="notes" id="tradeNotes" maxlength="3000" rows="3"></textarea></label>
          <label>TRADINGVIEW SNAPSHOT LINK (OPTIONAL)
            <input type="url" name="tradingViewUrl" id="tradeTradingViewUrl" maxlength="2048" placeholder="https://www.tradingview.com/x/..." data-tradingview-input autocomplete="url">
          </label>
          <p class="micro">Paste a public TradingView snapshot link to preview its chart image. The screenshot loads directly from TradingView.</p>
          <div class="upload-preview tradingview-preview" data-tradingview-preview hidden></div>
          <div id="tradeExistingImage" class="trade-existing-images"></div>
          <label>ADD TRADE IMAGES (OPTIONAL · UP TO 10 PER TRADE · JPEG, PNG OR WEBP · MAX 5 MB EACH)<input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple data-image-input></label>
          <div class="upload-preview" data-upload-preview hidden></div>
          <p class="notice danger upload-error" role="alert" hidden></p>
          <button type="submit" class="primary full">SAVE CHANGES</button>
        </form>
      </dialog>

