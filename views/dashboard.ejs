<!doctype html>
<%
  const settingsReady=typeof preferencesFor==='function';
  const preferences=settingsReady?preferencesFor(user):{
    defaultTab:'trading',defaultCurrency:'USD',calendarCurrency:'USD',analysisRange:'month',
    showWorldClocks:true,showForexHours:true,showNyReminder:true,showEconomicCalendar:true,showMotivationalMessage:true
  };

  /* ---- P&L helpers: + is always green, - is always red ---- */
  const fmtPnl=(n,c)=>{
    const v=Number(n)||0;
    const sign=v>0?'+':v<0?'−':'';
    return sign+Math.abs(v).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})+' '+(c||'USD');
  };
  const pnlClass=n=>(Number(n)||0)>0?'pnl-pos':(Number(n)||0)<0?'pnl-neg':'';

  /* ---- Today's numbers for the new cards ---- */
  const todayTotals={};
  todays.forEach(t=>{ const c=t.currency||'USD'; todayTotals[c]=(todayTotals[c]||0)+(Number(t.pnl)||0); });
  const todayTotalEntries=Object.entries(todayTotals);
  const tradesLeft=Math.max(0,limits.maxTrades-todays.length);
  const lossesLeft=Math.max(0,limits.maxLosses-losses);
  const recentTrades=[...trades].sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).slice(0,5);
  const activeRulesCount=rules.filter(r=>r.active).length;
%>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#060608">
    <title>DISCIPLINE / My Rules. My Edge.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=20261111-3">
    <script src="/app.js?v=20261111-2" defer></script>
    <script src="/pnl-colors.js?v=20261110-1" defer></script>
  </head>
  <body>
    <main class="app" data-default-tab="<%= preferences.defaultTab %>">
      <header class="top">
        <div class="brand">
          <div class="brandmark">D<span>.</span></div>
          <div>
            <div class="eyebrow">TRADING DISCIPLINE</div>
            <div class="brandline">MY RULES. MY EDGE.</div>
          </div>
        </div>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="ghost">SIGN OUT</button>
        </form>
      </header>

      <% if (error) { %>
        <div class="notice danger"><%= error %></div>
      <% } %>
      <% if (typeof success!=='undefined' && success) { %>
        <div class="notice success" role="status"><%= success %></div>
      <% } %>

      <nav class="dashboard-tabs" role="tablist" aria-label="Dashboard sections">
        <a id="tab-trading" role="tab" aria-selected="true" href="#trading" data-tab-target="trading">TRADE</a>
        <a id="tab-journal" role="tab" aria-selected="false" href="#journal" data-tab-target="journal">JOURNAL</a>
        <a id="tab-calendar" role="tab" aria-selected="false" href="#calendar" data-tab-target="calendar">CALENDAR</a>
        <a id="tab-rules" role="tab" aria-selected="false" href="#rules" data-tab-target="rules">RULES</a>
        <a id="tab-settings" role="tab" aria-selected="false" href="#settings" data-tab-target="settings">SETTINGS</a>
      </nav>

      <section class="dashboard-tabpanel active" id="trading" role="tabpanel" aria-labelledby="tab-trading">
        <section class="hero">
          <div class="eyebrow">
            <span>TODAY'S STATUS</span>
            <span><%= today %></span>
            <span class="trade-status <%= locked ? 'status-locked' : cooldown ? 'status-cooldown' : 'status-ready' %>"><%= locked ? 'LOCKED' : cooldown ? 'COOLDOWN' : 'READY' %></span>
          </div>
          <h1>SESSION CHECK-IN</h1>
          <p>Check your limits, market sessions, and plan before you trade.</p>
          <div class="status-strip">
            <div>
              <span>TRADES</span>
              <strong><%= todays.length %> / <%= limits.maxTrades %></strong>
            </div>
            <div>
              <span>LOSSES</span>
              <strong class="<%= losses ? 'red' : '' %>"><%= losses %> / <%= limits.maxLosses %></strong>
            </div>
            <div>
              <span>WINS</span>
              <strong class="<%= todays.some(t => t.outcome === 'WIN') ? 'green' : '' %>"><%= todays.filter(t => t.outcome === 'WIN').length %></strong>
            </div>
            <div>
              <span>TODAY P&amp;L</span>
              <% if (todayTotalEntries.length) { %>
                <% todayTotalEntries.forEach(([cur, val]) => { %>
                  <strong class="money <%= pnlClass(val) %>"><%= fmtPnl(val, cur) %></strong>
                <% }) %>
              <% } else { %>
                <strong>—</strong>
              <% } %>
            </div>
          </div>
        </section>
        <% if (preferences.showMotivationalMessage && preferences.motivationalMessage) { %>
          <aside class="motivation-panel" aria-label="Your personal motivation">
            <div>
              <span class="eyebrow">MOTIVATIONAL REMINDER</span>
              <p><%= preferences.motivationalMessage %></p>
            </div>
            <a href="#settings" class="tag" data-tab-target="settings">EDIT</a>
          </aside>
        <% } %>

        <h2 class="trade-group-heading">SESSION &amp; AVAILABILITY</h2>
        <div class="trading-overview-grid">
          <section class="panel timer-panel account-lock-panel <%= locked ? 'locked-panel' : cooldown ? 'cooldown-panel' : '' %>">
            <div class="section-heading">
              <span><%= locked ? 'DAILY ACCOUNT LOCK' : cooldown ? 'TRADE COOLDOWN' : 'ACCOUNT STATUS' %></span>
              <span class="tag <%= locked ? 'tag-red' : cooldown ? 'tag-amber' : 'tag-green' %>"><%= locked ? 'LOCKED' : cooldown ? 'WAIT' : 'READY' %></span>
            </div>
            <% if (availableAtLabel) { %>
              <p class="timer-hint lock-explanation">
                <% if (locked) { %>
                  <%= lockReason %>. Resets at midnight in your account timezone.
                <% } else { %>
                  Cooldown after a recorded loss.
                <% } %>
              </p>
              <div class="ny-session-milestone">TIME UNTIL UNLOCK</div>
              <div class="timer-face <%= cooldown && !locked ? 'amber' : '' %>" id="timer" data-until="<%= availableAt.toISOString() %>" aria-label="00 days, 00 hours, 00 minutes, 00 seconds">0d 00h 00m 00s</div>
              <div class="time-conversions">
                <% if (user.timezone === 'Europe/Sofia') { %>
                  <div class="time-conversion">
                    <span>Your account + Bulgaria · Europe/Sofia</span>
                    <strong><%= availableAtLabel %></strong>
                  </div>
                  <div class="time-conversion">
                    <span>New York</span>
                    <strong><%= availableAtNyLabel %></strong>
                  </div>
                <% } else { %>
                  <div class="time-conversion">
                    <span>Your account · <%= user.timezone %></span>
                    <strong><%= availableAtLabel %></strong>
                  </div>
                  <div class="time-conversion">
                    <span>New York</span>
                    <strong><%= availableAtNyLabel %></strong>
                  </div>
                  <div class="time-conversion">
                    <span>Bulgaria</span>
                    <strong><%= availableAtBulgariaLabel %></strong>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <div class="timer-face account-ready">READY</div>
              <p class="timer-hint lock-explanation">No active daily lock or cooldown.</p>
            <% } %>
            <div class="time-conversions limits-left">
              <div class="time-conversion">
                <span>TRADES LEFT TODAY</span>
                <strong><%= tradesLeft %> of <%= limits.maxTrades %></strong>
              </div>
              <div class="time-conversion">
                <span>LOSSES LEFT BEFORE LOCK</span>
                <strong class="<%= lossesLeft === 0 ? 'pnl-neg' : '' %>"><%= lossesLeft %> of <%= limits.maxLosses %></strong>
              </div>
            </div>
            <div class="progress" title="Trades used today">
              <div class="<%= cooldown && !locked ? 'amber-bg' : '' %>" style="width:<%= Math.min(100, Math.round(todays.length / Math.max(1, limits.maxTrades) * 100)) %>%"></div>
            </div>
          </section>

          <% if (preferences.showNyReminder) { %>
          <% const nyLive = nySession.phase && nySession.phase.startsWith('PRE-MARKET IS OPEN') ? 'premarket' : nySession.phase && nySession.phase.startsWith('REGULAR') ? 'regular' : ''; %>
          <section class="panel ny-session-panel<%= nyLive ? ' is-' + nyLive : '' %>" id="nySessionPanel" aria-labelledby="nySessionTitle">
            <div class="section-heading">
              <span id="nySessionTitle">NEW YORK SESSION</span>
              <span class="tag ny-session-badge" id="nySessionBadge"><%= nyLive === 'premarket' ? 'PRE-MARKET OPEN' : nyLive === 'regular' ? 'NY SESSION OPEN' : 'US EQUITIES · ET' %></span>
            </div>
            <div class="ny-live-banner visually-hidden" id="nyLiveBanner" role="status"<%= nyLive ? '' : ' hidden' %>>
              <span class="ny-live-dot" aria-hidden="true"></span>
              <strong id="nyLiveLabel"><%= nyLive === 'regular' ? 'NY SESSION OPEN' : 'PRE-MARKET OPEN' %></strong>
              <span class="ny-live-countdown" id="nyLiveCountdown" role="timer" aria-live="off"></span>
            </div>
            <div class="ny-session-phase visually-hidden" id="nySessionPhase"><%= nySession.phase %></div>
            <div class="ny-session-milestone" id="nySessionMilestone">NEXT PRE-MARKET · 8:30 AM ET</div>
            <div class="timer-face ny-session-timer" id="nySessionTimer" data-schedule="<%= encodeURIComponent(JSON.stringify(nySession.schedule)) %>" data-account-timezone="<%= user.timezone %>">0d 00h 00m 00s</div>
            <div class="ny-session-hours">PRE-MARKET 8:30–9:30 · REGULAR 9:30–16:00 ET</div>
            <details class="ny-session-local-times">
              <summary>LOCAL TIME DETAILS</summary>
              <div class="session-time-list" id="nySessionTarget" aria-live="polite"></div>
            </details>
          </section>
          <% } %>
        </div>

        <h2 class="trade-group-heading">BEFORE YOU TRADE</h2>
        <div class="trading-work-grid">
          <section class="panel" id="trade">
            <div class="section-heading">
              <span>01 / PRE-TRADE CHECKLIST</span>
              <span class="tag"><%= checks.length %> OF <%= active.length %></span>
            </div>
            <p class="muted small">Confirm each statement honestly before every trade.</p>
            <% if (locked || cooldown) { %>
              <div class="checklist-paused <%= locked ? 'paused-locked' : 'paused-cooldown' %>">
                <strong><%= locked ? 'CHECKLIST PAUSED · DAILY LOCK' : 'CHECKLIST PAUSED · COOLDOWN' %></strong>
                <span><%= locked ? lockReason : 'A recorded loss started a cooldown' %>. Trading becomes available at <%= availableAtLabel %> account time.</span>
                <% if (availableAt) { %>
                  <div class="timer-face checklist-unlock-timer <%= cooldown && !locked ? 'amber' : '' %>" data-until="<%= availableAt.toISOString() %>" aria-label="Time until trading is available">0d 00h 00m 00s</div>
                <% } %>
                <small>Refresh the page after the countdown to continue.</small>
              </div>
            <% } else { %>
              <% if (state.checkTime && checks.length === active.length && active.length) { %>
                <div class="notice success">CHECKLIST COMPLETE. Record your outcome after the trade.</div>
              <% } %>
              <form method="post" action="/check">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <div class="checklist">
                  <% active.forEach((r, i) => { %>
                    <label class="rule">
                      <input type="checkbox" name="rules" value="<%= r._id %>" <%= checks.includes(String(r._id)) ? 'checked' : '' %>>
                      <span>
                        <strong><%= r.title %></strong>
                        <small><%= r.description || 'Follow this rule before entering.' %></small>
                      </span>
                    </label>
                  <% }) %>
                </div>
                <label class="field-label">CURRENT EMOTIONAL STATE
                  <select name="mood">
                    <option value="calm">Calm and focused</option>
                    <option value="fomo">FOMO / impatient</option>
                    <option value="revenge">Angry / revenge</option>
                  </select>
                </label>
                <button class="primary full" <%= !active.length ? 'disabled' : '' %>>COMPLETE PRE-TRADE CHECK</button>
              </form>
            <% } %>
          </section>

          <div class="trade-sidecards">
            <section class="panel">
              <div class="section-heading">
                <span>02 / RECORD OUTCOME</span>
              </div>
              <p class="muted small">Record a completed trade. Losses start a cooldown; your daily limits can lock trading.</p>
              <div class="actions">
                <a href="#journal" class="outline outcome-win" data-record-outcome="WIN">+ RECORD WIN</a>
                <a href="#journal" class="outline outcome-loss" data-record-outcome="LOSS">− RECORD LOSS</a>
              </div>
            </section>
            <section class="stop-panel <%= locked ? 'locked-panel' : '' %>">
              <div>
                <div class="eyebrow">EMERGENCY CONTROL</div>
                <h2>STOP TRADING.</h2>
                <p>Protect your account. End your session for today.</p>
              </div>
              <form method="post" action="/stop" data-confirm="Lock trading for the rest of today?">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="stop" <%= locked ? 'disabled' : '' %>>LOCK TODAY</button>
              </form>
            </section>
          </div>
        </div>

        <% if (preferences.showWorldClocks || preferences.showForexHours || preferences.showEconomicCalendar) { %>
        <h2 class="trade-group-heading">MARKETS &amp; CLOCKS</h2>
        <% } %>
      <% if (preferences.showWorldClocks) { %>
      <section class="panel world-clock-panel" aria-label="Current time in your account timezone and market timezones">
        <div class="world-clock-heading">
          <strong>WORLD CLOCKS</strong>
          <span>LIVE · 24-HOUR TIME</span>
        </div>
        <div class="world-clock-grid">
          <article class="world-clock-card" data-world-clock data-timezone="<%= user.timezone %>">
            <span class="world-clock-label"><%= user.timezone === 'Europe/Sofia' ? 'YOUR TIME · BULGARIA' : 'YOUR ACCOUNT TIME' %></span>
            <time class="world-clock-time">--:--:--</time>
            <span class="world-clock-date"><%= user.timezone %></span>
          </article>
          <article class="world-clock-card" data-world-clock data-timezone="America/New_York">
            <span class="world-clock-label">NEW YORK</span>
            <time class="world-clock-time">--:--:--</time>
            <span class="world-clock-date">America/New_York</span>
          </article>
          <% if (user.timezone !== 'Europe/Sofia') { %>
            <article class="world-clock-card" data-world-clock data-timezone="Europe/Sofia">
              <span class="world-clock-label">BULGARIA</span>
              <time class="world-clock-time">--:--:--</time>
              <span class="world-clock-date">Europe/Sofia</span>
            </article>
          <% } %>
        </div>
      </section>
      <% } %>

        <% if (preferences.showForexHours) { %>
        <section class="panel fx-session-panel" aria-labelledby="fxSessionTitle">
          <div class="section-heading">
            <span id="fxSessionTitle">FOREX MARKET HOURS</span>
            <span class="tag" id="fxSessionSummary">SOFIA TIME · UPDATING</span>
          </div>
          <div class="fx-session-grid" id="fxSessionGrid" aria-live="polite">
            <article class="fx-session-card" data-session="sydney">
              <div class="fx-session-card-heading"><strong>Sydney</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">08:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">17:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
            <article class="fx-session-card" data-session="tokyo">
              <div class="fx-session-card-heading"><strong>Tokyo</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">09:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">18:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
            <article class="fx-session-card" data-session="london">
              <div class="fx-session-card-heading"><strong>London</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">08:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">17:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
            <article class="fx-session-card" data-session="new-york">
              <div class="fx-session-card-heading"><strong>New York</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">08:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">17:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
          </div>
          <p class="micro">Opening and closing times are shown in Sofia time (Europe/Sofia), using a 24-hour clock. Timers count down to closing for active sessions, or the next weekday opening for closed sessions. Weekends are skipped; market holidays are not included. Sessions, overlaps and timers update live; daylight-saving changes are automatic.</p>
        </section>
        <% } %>

        <% if (preferences.showEconomicCalendar) { %>
        <section class="panel economic-calendar-panel" aria-labelledby="economicCalendarTitle">
          <div class="section-heading">
            <span id="economicCalendarTitle">ECONOMIC CALENDAR</span>
            <span class="tag">US · HIGH IMPACT</span>
          </div>
          <div class="economic-calendar-frame">
            <tv-economic-calendar countries="us" high-importance-only theme="dark"></tv-economic-calendar>
          </div>
          <p class="micro">Economic events are provided by TradingView. If the calendar does not appear, check your connection or browser content blockers.</p>
          <script type="module" src="https://widgets.tradingview-widget.com/w/en/tv-economic-calendar.js"></script>
        </section>
        <% } %>

      </section>

      <section class="dashboard-tabpanel" id="rules" role="tabpanel" aria-labelledby="tab-rules" hidden>
        <section class="panel">
          <div class="section-heading">
            <span>MY TRADING RULES</span>
            <span class="tag"><%= activeRulesCount %> ACTIVE · <%= rules.length %> TOTAL</span>
          </div>
          <p class="muted small">Manage your trading rules. Only active rules appear in your pre-trade checklist.</p>
          <div class="rule-manager-list">
            <% rules.forEach((r, i) => { %>
              <div class="rule-manager-row">
                <div class="rule-manager-number"><%= String(i + 1).padStart(2, '0') %></div>
                <div class="rule-manager-copy">
                  <strong><%= r.title %></strong>
                  <small><%= r.active ? 'ACTIVE' : 'INACTIVE' %><% if (r.description) { %> · <%= r.description %><% } %></small>
                </div>
                <button type="button" class="outline rule-edit-trigger" data-id="<%= r._id %>" data-title="<%= r.title %>" data-description="<%= r.description || '' %>" data-active="<%= r.active ? 'true' : 'false' %>" aria-label="Edit rule <%= r.title %>">EDIT</button>
              </div>
            <% }) %>
          </div>
          <button type="button" class="primary full" id="addRuleBtn">+ ADD NEW RULE</button>
        </section>
      </section>

      <dialog id="ruleDialog" class="rule-dialog" aria-labelledby="ruleDialogTitle">
        <div class="rule-dialog-head">
          <div>
            <div class="eyebrow">DISCIPLINE / RULE MANAGER</div>
            <h2 id="ruleDialogTitle">EDIT RULE</h2>
          </div>
          <form method="dialog" class="dialog-close-form">
            <button type="submit" class="rule-dialog-close ghost" id="closeRuleDialog" aria-label="Close dialog">✕</button>
          </form>
        </div>
        <form method="post" id="ruleEditor" class="journal-form" action="/rules">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>RULE TITLE<input name="title" id="ruleTitle" maxlength="140" required placeholder="I don't chase trades"></label>
          <label>DESCRIPTION<textarea name="description" id="ruleDescription" maxlength="500" rows="4" placeholder="Why this rule matters"></textarea></label>
          <label class="inline-check"><input type="checkbox" id="ruleActive" name="active" checked> RULE IS ACTIVE</label>
          <button type="submit" class="primary full" id="ruleSave">SAVE RULE</button>
        </form>
        <form method="post" id="ruleDeleteForm" action="/rules" data-confirm="Permanently delete this trading rule?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="textbutton danger-text">DELETE THIS RULE</button>
        </form>
      </dialog>

      <section class="dashboard-tabpanel" id="journal" role="tabpanel" aria-labelledby="tab-journal" hidden>
        <div class="journal-grid">
        <section class="panel">
          <div class="section-heading">
            <span>04 / TRADING JOURNAL</span>
            <a href="/export" class="tag">EXPORT CSV</a>
          </div>
          <p class="muted small">Add a trade record here. Choose a session if you’re logging later, or leave it on automatic detection. Browse, preview, and edit saved records in the calendar.</p>
          <form method="post" action="/trades" id="journalTradeForm" class="journal-form" enctype="multipart/form-data" data-image-upload data-plan-follow-up>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (!checklistCompleted) { %>
              <p class="notice warning">No completed checklist is recorded today. Did you follow your plan anyway? If not, explain why before saving.</p>
            <% } %>
            <label>TRADING ACCOUNT<input name="account" maxlength="80" placeholder="e.g. Personal, FTMO 100K"></label>
            <label>TRADING SESSION
              <select name="session">
                <% sessionChoices.forEach(choice => { %>
                  <option value="<%= choice %>" <%= choice === 'auto' ? 'selected' : '' %>><%= choice === 'auto' ? 'Automatic · based on save time' : choice %></option>
                <% }) %>
              </select>
            </label>
            <div class="form-row">
              <label>INSTRUMENT<input name="instrument" maxlength="40" placeholder="XAUUSD"></label>
              <label>DIRECTION
                <select name="side">
                  <option value="">Not specified</option>
                  <option>BUY</option>
                  <option>SELL</option>
                </select>
              </label>
            </div>
            <div class="form-row">
              <label>OUTCOME
                <select name="outcome" id="journalOutcome" required>
                  <option>WIN</option>
                  <option>LOSS</option>
                  <option>BREAKEVEN</option>
                </select>
              </label>
              <label>P&amp;L<input name="pnl" type="number" step="0.01" value="0" required></label>
            </div>
            <label>CURRENCY CODE<input name="currency" maxlength="3" minlength="3" pattern="[A-Za-z]{3}" value="<%= preferences.defaultCurrency %>" required autocomplete="off" placeholder="USD"></label>
            <label>STRATEGY<input name="strategy" maxlength="120" placeholder="e.g. NY open breakout, pullback"></label>
            <label>EMOTION
              <select name="emotion">
                <option value="calm">Calm</option>
                <option value="fomo">FOMO</option>
                <option value="revenge">Revenge impulse</option>
                <option value="other">Other</option>
              </select>
            </label>
            <label class="inline-check"><input type="checkbox" name="followedPlan" id="journalFollowedPlan" <%= checklistCompleted ? 'checked' : '' %>> YES, I FOLLOWED MY PLAN</label>
            <label id="journalPlanDeviationField" data-plan-deviation <%= checklistCompleted ? 'hidden' : '' %>>WHY DIDN'T YOU FOLLOW YOUR PLAN?
              <textarea name="planDeviationReason" maxlength="500" rows="2" <%= checklistCompleted ? '' : 'required' %> placeholder="Briefly explain what happened."></textarea>
            </label>
            <label>LESSON / NOTES<textarea name="notes" maxlength="3000" rows="3" placeholder="What happened? What did I learn?"></textarea></label>
            <label>TRADE IMAGE (OPTIONAL · JPEG, PNG OR WEBP · MAX 5 MB)<input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-image-input></label>
            <div class="upload-preview" data-upload-preview hidden></div>
            <p class="notice danger upload-error" role="alert" hidden></p>
            <button type="submit" class="primary">SAVE TRADE</button>
          </form>
        </section>

        <section class="panel recent-trades" aria-labelledby="recentTradesTitle">
          <div class="section-heading">
            <span id="recentTradesTitle">RECENT TRADES</span>
            <span class="tag">LAST <%= recentTrades.length %></span>
          </div>
          <% if (!recentTrades.length) { %>
            <p class="empty">No trades recorded yet. Your latest five will appear here.</p>
          <% } else { %>
            <div class="journal-list">
              <% recentTrades.forEach(t => { %>
                <div class="journal-item">
                  <div class="journal-item-head">
                    <strong><%= t.instrument || 'Trade' %><% if (t.side) { %> · <%= t.side %><% } %></strong>
                    <strong class="<%= pnlClass(t.pnl) %>"><%= fmtPnl(t.pnl, t.currency) %></strong>
                  </div>
                  <p><%= dayKey(t.createdAt, user.timezone) %> · <%= t.outcome %><% if (t.account) { %> · <%= t.account %><% } %><% if (t.session) { %> · <%= t.session %><% } %><% if (t.checklistCompleted === true) { %> · Checklist completed<% } else if (t.checklistCompleted === false) { %> · Checklist missed<% } %><% if (t.strategy) { %> · <%= t.strategy %><% } %><% if (t.followedPlan === false) { %> · Plan not followed<% } %></p>
                  <% if (t.planDeviationReason) { %><p>Plan deviation: <%= t.planDeviationReason %></p><% } %>
                </div>
              <% }) %>
            </div>
            <p class="micro">Open the Calendar tab to edit, replace images or delete a record.</p>
          <% } %>
        </section>
        </div>
      </section>

      <dialog id="tradeDialog" class="rule-dialog trade-dialog" aria-labelledby="tradeDialogTitle">
        <div class="rule-dialog-head">
          <div>
            <div class="eyebrow">JOURNAL / CALENDAR RECORD</div>
            <h2 id="tradeDialogTitle">EDIT TRADE</h2>
            <p id="tradeEditDate" class="micro"></p>
          </div>
          <form method="dialog" class="dialog-close-form">
            <button type="submit" class="rule-dialog-close ghost" id="closeTradeDialog" aria-label="Close dialog">✕</button>
          </form>
        </div>
        <form method="post" id="tradeEditor" class="journal-form" action="/trades" enctype="multipart/form-data" data-image-upload data-plan-follow-up>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>TRADING ACCOUNT<input name="account" id="tradeAccount" maxlength="80"></label>
          <label>TRADING SESSION
            <select name="session" id="tradeSession">
              <option value="">Not recorded</option>
              <% sessionChoices.filter(choice => choice !== 'auto').forEach(choice => { %>
                <option value="<%= choice %>"><%= choice %></option>
              <% }) %>
            </select>
          </label>
          <div class="form-row">
            <label>INSTRUMENT<input name="instrument" id="tradeInstrument" maxlength="40"></label>
            <label>DIRECTION
              <select name="side" id="tradeSide">
                <option value="">Not specified</option>
                <option>BUY</option>
                <option>SELL</option>
              </select>
            </label>
          </div>
          <div class="form-row">
            <label>OUTCOME
              <select name="outcome" id="tradeOutcome" required>
                <option>WIN</option>
                <option>LOSS</option>
                <option>BREAKEVEN</option>
              </select>
            </label>
            <label>P&amp;L<input name="pnl" id="tradePnl" type="number" step="0.01" required></label>
          </div>
          <label>CURRENCY CODE<input name="currency" id="tradeCurrency" maxlength="3" minlength="3" pattern="[A-Za-z]{3}" required autocomplete="off"></label>
          <label>STRATEGY<input name="strategy" id="tradeStrategy" maxlength="120" placeholder="e.g. NY open breakout, pullback"></label>
          <label>EMOTION
            <select name="emotion" id="tradeEmotion">
              <option value="calm">Calm</option>
              <option value="fomo">FOMO</option>
              <option value="revenge">Revenge impulse</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label class="inline-check"><input type="checkbox" name="followedPlan" id="tradeFollowedPlan"> I FOLLOWED MY PLAN</label>
          <label id="tradePlanDeviationField" data-plan-deviation>WHY DIDN'T YOU FOLLOW YOUR PLAN?
            <textarea name="planDeviationReason" id="tradePlanDeviationReason" maxlength="500" rows="2" placeholder="Briefly explain what happened."></textarea>
          </label>
          <p id="tradeChecklistStatus" class="micro"></p>
          <label>LESSON / NOTES<textarea name="notes" id="tradeNotes" maxlength="3000" rows="3"></textarea></label>
          <div id="tradeExistingImage"></div>
          <label>REPLACE / ADD TRADE IMAGE (OPTIONAL · JPEG, PNG OR WEBP · MAX 5 MB)<input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-image-input></label>
          <label class="inline-check" id="removeTradeImageLabel" hidden><input type="checkbox" name="removeImage" id="removeTradeImage"> REMOVE CURRENT IMAGE</label>
          <div class="upload-preview" data-upload-preview hidden></div>
          <p class="notice danger upload-error" role="alert" hidden></p>
          <button type="submit" class="primary full">SAVE CHANGES</button>
        </form>
      </dialog>

      <dialog id="imagePreviewDialog" class="image-preview-dialog" aria-label="Trade image preview">
        <form method="dialog" class="dialog-close-form">
          <button type="submit" class="ghost image-preview-close" aria-label="Close image preview">CLOSE ✕</button>
        </form>
        <p id="imagePreviewStatus" class="image-preview-status" role="status">Loading image preview…</p>
        <img id="imagePreviewFull" alt="Full-size trade attachment preview" hidden>
      </dialog>

      <section class="dashboard-tabpanel" id="calendar" role="tabpanel" aria-labelledby="tab-calendar" hidden>
        <section class="panel performance-calendar">
          <div class="section-heading calendar-head">
            <div>
              <h2>MONTH BY MONTH</h2>
              <p id="calendarYearCaption" class="micro"></p>
            </div>
            <div class="calendar-controls">
              <label class="calendar-currency-label">CURRENCY
                <select id="calendarCurrency" aria-label="Calendar currency"></select>
              </label>
              <div id="calendarYears" class="calendar-years" role="group" aria-label="Calendar year"></div>
            </div>
          </div>
          <div id="monthlyPerformance" class="monthly-performance" role="group" aria-label="Monthly profit and loss; select a month"></div>
          <div class="calendar-workspace">
            <aside class="calendar-overview">
              <div class="calendar-nav">
                <button type="button" class="outline" id="prevMonth" aria-label="Previous month">‹</button>
                <strong id="monthTitle"></strong>
                <button type="button" class="outline" id="nextMonth" aria-label="Next month">›</button>
              </div>
              <div id="monthPnl" class="month-pnl"></div>
              <p id="calendarMonthCaption" class="micro"></p>
              <div id="calendarMonthStats" class="calendar-month-stats"></div>
              <p class="micro">Select a date to preview, edit or delete its trades. All dates use your account timezone.</p>
            </aside>
            <div class="calendar-scroll" tabindex="0" role="region" aria-label="Daily results and weekly totals">
              <div id="calendarGrid" class="calendar" data-timezone="<%= user.timezone %>" data-today="<%= today %>" data-csrf="<%= csrf %>" data-default-currency="<%= preferences.calendarCurrency %>" data-analysis-range="<%= preferences.analysisRange %>"></div>
            </div>
          </div>
          <details class="calendar-month-table">
            <summary>All months in a table</summary>
            <div class="calendar-table-scroll">
              <table>
                <thead><tr><th scope="col">Month</th><th scope="col">Trades</th><th scope="col">Win rate</th><th scope="col">Net P&amp;L</th></tr></thead>
                <tbody id="calendarMonthRows"></tbody>
              </table>
            </div>
          </details>
          <div id="selectedDay" class="day-summary">Select a day to review its trade records.</div>
          <details class="calendar-analysis-details">
            <summary>Detailed performance analysis</summary>
          <section class="calendar-analysis" aria-labelledby="analysisTitle">
            <div class="analysis-heading">
              <div>
                <h2 id="analysisTitle">PERFORMANCE ANALYSIS</h2>
                <p id="analysisPeriodLabel">Selected month</p>
              </div>
              <div class="analysis-periods" role="group" aria-label="Analysis period">
                <button type="button" class="analysis-period is-selected" data-analysis-range="month" aria-pressed="true">MONTH</button>
                <button type="button" class="analysis-period" data-analysis-range="7d" aria-pressed="false">7 DAYS</button>
                <button type="button" class="analysis-period" data-analysis-range="30d" aria-pressed="false">30 DAYS</button>
                <button type="button" class="analysis-period" data-analysis-range="all" aria-pressed="false">ALL TIME</button>
              </div>
            </div>
            <div class="analysis-metrics">
              <article class="analysis-metric"><span>TRADES</span><strong id="analysisTradeCount">0</strong></article>
              <article class="analysis-metric"><span>WIN RATE</span><strong id="analysisWinRate">—</strong></article>
              <article class="analysis-metric"><span>PLAN FOLLOWED</span><strong id="analysisPlanRate">—</strong></article>
              <article class="analysis-metric analysis-net"><span>NET P&amp;L · BY CURRENCY</span><div id="analysisNetPnl"></div></article>
            </div>
            <section class="performance-stats" aria-labelledby="performanceStatsTitle">
              <div class="analysis-chart-heading">
                <div>
                  <h3 id="performanceStatsTitle">ACCOUNT IN NUMBERS</h3>
                  <p id="performanceStatsCaption"></p>
                </div>
                <label class="analysis-currency-label">STATS &amp; CHART CURRENCY
                  <select id="analysisCurrency" aria-label="Statistics and chart currency" disabled></select>
                </label>
              </div>
              <div id="performanceStats"></div>
              <p class="analysis-footnote">These statistics use only the selected currency and analysis period. Monthly averages include recorded months only; partial months use only trades in this period. Average wins/losses and profit factor use signed P&amp;L. Win rate uses recorded outcomes, excluding break-even. Drawdown uses realized cumulative P&amp;L starting at zero, not account equity; percentage drawdown requires balance history.</p>
            </section>
            <section class="streak-analysis" aria-label="Winning and losing streaks">
              <article class="streak-card streak-win">
                <span>WIN STREAK</span>
                <div><strong id="currentWinStreak">0</strong><small>current</small></div>
                <div><strong id="bestWinStreak">0</strong><small>best in period</small></div>
              </article>
              <article class="streak-card streak-loss">
                <span>LOSS STREAK</span>
                <div><strong id="currentLossStreak">0</strong><small>current</small></div>
                <div><strong id="worstLossStreak">0</strong><small>worst in period</small></div>
              </article>
            </section>
            <div class="analysis-charts">
              <section class="analysis-chart-card" aria-labelledby="equityChartTitle">
                <div class="analysis-chart-heading">
                  <div>
                    <h3 id="equityChartTitle">CUMULATIVE P&amp;L</h3>
                    <p id="equityChartCaption">Choose a currency to view performance.</p>
                  </div>
                </div>
                <svg id="equityChart" class="equity-chart" viewBox="0 0 760 240" role="img" aria-label="Cumulative profit and loss chart"></svg>
                <p class="analysis-empty" id="equityChartEmpty" hidden>No trades in this period.</p>
              </section>
              <section class="analysis-chart-card outcome-card" aria-labelledby="outcomeChartTitle">
                <h3 id="outcomeChartTitle">TRADE OUTCOMES</h3>
                <p class="analysis-chart-subtitle">Results in this period</p>
                <div class="outcome-breakdown" id="outcomeBreakdown"></div>
              </section>
            </div>
            <section class="daily-analysis" aria-labelledby="dailyAnalysisTitle">
              <div class="analysis-chart-heading">
                <div>
                  <h3 id="dailyAnalysisTitle">DAY-BY-DAY RESULTS</h3>
                  <p id="dailyAnalysisCaption">Daily net result in selected currency.</p>
                </div>
              </div>
              <div class="daily-bars" id="dailyBars" role="list" aria-label="Daily profit and loss"></div>
            </section>
            <p class="analysis-footnote">Win rate excludes break-even trades. A break-even trade resets a streak. P&amp;L is never combined across different currencies.</p>
          </section>
          </details>
          <p class="micro">Calendar P&amp;L uses the selected currency only, without currency conversion. Green = positive · Red = negative · Grey = break-even. Return percentages require account balance data and are not calculated.</p>
        </section>
      </section>

      <section class="dashboard-tabpanel" id="settings" role="tabpanel" aria-labelledby="tab-settings" hidden>
        <% const pending=user.pendingSettings; const editable=pending || user; %>
        <% if (!settingsReady) { %>
          <p class="notice warning">Restart the app server to enable saving settings. Your existing data is unchanged.</p>
        <% } %>
        <section class="panel">
          <div class="section-heading"><span>YOUR SETTINGS</span><span class="tag">PRIVATE TO YOUR ACCOUNT</span></div>
          <p class="muted small">Manage your profile, discipline, journal and dashboard. Changes affect only your account. Existing trade currencies and dates are not rewritten.</p>
          <% if (pending) { %>
            <p class="notice warning">Pending discipline and timezone changes take effect at <%= new Intl.DateTimeFormat('en-GB',{timeZone:user.timezone,dateStyle:'medium',timeStyle:'short'}).format(pending.effectiveAt) %> (<%= user.timezone %>). Until then: <%= user.limits.maxTrades %> trades, <%= user.limits.maxLosses %> losses, <%= user.limits.cooldownMinutes %> minute cooldown. Saving the current active values cancels pending changes.</p>
          <% } %>
          <form method="post" action="/settings" class="journal-form settings-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>PROFILE</legend>
              <label>DISPLAY NAME<input name="name" value="<%= user.name %>" minlength="2" maxlength="80" autocomplete="name" required></label>
              <p class="micro">Signed in as <%= user.email %>. Your login email is not changed here.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>PERSONAL MOTIVATION</legend>
              <label>YOUR DASHBOARD MESSAGE
                <textarea name="motivationalMessage" maxlength="500" rows="3" placeholder="Write a reminder that helps you stay focused and disciplined."><%= preferences.motivationalMessage %></textarea>
              </label>
              <label class="inline-check"><input type="checkbox" name="showMotivationalMessage" <%= preferences.showMotivationalMessage?'checked':'' %>> SHOW MOTIVATIONAL MESSAGE ON DASHBOARD</label>
              <p class="micro">Only you can see this message. Hiding it keeps your text saved; clearing it restores the starter reminder.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>DISCIPLINE</legend>
              <div class="settings-fields">
                <label>MAX TRADES PER DAY<input type="number" name="maxTrades" value="<%= editable.limits.maxTrades %>" min="1" max="100" step="1" required></label>
                <label>MAX LOSSES PER DAY<input type="number" name="maxLosses" value="<%= editable.limits.maxLosses %>" min="1" max="100" step="1" required></label>
                <label>COOLDOWN AFTER A LOSS (MINUTES)<input type="number" name="cooldownMinutes" value="<%= editable.limits.cooldownMinutes %>" min="1" max="240" step="1" required></label>
              </div>
              <p class="micro">Discipline and timezone changes are scheduled for the next midnight in your current account timezone. Saving settings never clears today's emergency stop or an active cooldown. Zero / unlimited limits are not supported.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>REGIONAL &amp; JOURNAL</legend>
              <div class="settings-fields">
                <label>ACCOUNT TIMEZONE
                  <select name="timezone" required>
                    <% [...new Set([editable.timezone,...(settingsReady?settingsTimezones:Intl.supportedValuesOf('timeZone'))])].sort().forEach(zone=>{ %>
                      <option value="<%= zone %>" <%= editable.timezone===zone?'selected':'' %>><%= zone %></option>
                    <% }) %>
                  </select>
                </label>
                <label>DEFAULT JOURNAL CURRENCY
                  <select name="defaultCurrency" required>
                    <% (settingsReady?settingsCurrencies:Intl.supportedValuesOf('currency')).forEach(currency=>{ %>
                      <option value="<%= currency %>" <%= preferences.defaultCurrency===currency?'selected':'' %>><%= currency %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <p class="micro">The account timezone controls daily limits and calendar grouping. Forex schedules stay in Sofia time. Default currency is used for new records only; no currency conversion occurs.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>DASHBOARD</legend>
              <label>DEFAULT TAB
                <select name="defaultTab">
                  <% [['trading','Trade'],['journal','Journal'],['calendar','Calendar'],['rules','Rules'],['settings','Settings']].forEach(([value,label])=>{ %>
                    <option value="<%= value %>" <%= preferences.defaultTab===value?'selected':'' %>><%= label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="inline-check"><input type="checkbox" name="showWorldClocks" <%= preferences.showWorldClocks?'checked':'' %>> SHOW WORLD CLOCKS</label>
              <label class="inline-check"><input type="checkbox" name="showForexHours" <%= preferences.showForexHours?'checked':'' %>> SHOW FOREX HOURS &amp; TIMERS</label>
              <label class="inline-check"><input type="checkbox" name="showNyReminder" <%= preferences.showNyReminder?'checked':'' %>> SHOW NEW YORK SESSION REMINDER</label>
              <label class="inline-check"><input type="checkbox" name="showEconomicCalendar" <%= preferences.showEconomicCalendar?'checked':'' %>> SHOW ECONOMIC CALENDAR</label>
              <p class="micro">The default tab applies when no tab is specified in the URL. Hiding a widget does not disable trading safeguards.</p>
            </fieldset>
            <fieldset <%= settingsReady?'':'disabled' %>>
              <legend>CALENDAR</legend>
              <div class="settings-fields">
                <label>DEFAULT CALENDAR CURRENCY
                  <select name="calendarCurrency">
                    <% (settingsReady?settingsCurrencies:Intl.supportedValuesOf('currency')).forEach(currency=>{ %>
                      <option value="<%= currency %>" <%= preferences.calendarCurrency===currency?'selected':'' %>><%= currency %></option>
                    <% }) %>
                  </select>
                </label>
                <label>DEFAULT ANALYSIS PERIOD
                  <select name="analysisRange">
                    <% [['month','Selected month'],['7d','Last 7 days'],['30d','Last 30 days'],['all','All time']].forEach(([value,label])=>{ %>
                      <option value="<%= value %>" <%= preferences.analysisRange===value?'selected':'' %>><%= label %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <p class="micro">Selections made inside the calendar are temporary. Save defaults here to keep them across visits.</p>
            </fieldset>
            <button type="submit" class="primary" <%= settingsReady?'':'disabled' %>>SAVE MY SETTINGS</button>
          </form>
        </section>
        <section class="panel">
          <div class="section-heading"><span>SECURITY / CHANGE PASSWORD</span></div>
          <form method="post" action="/settings/password" class="journal-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label>CURRENT PASSWORD<input type="password" name="currentPassword" autocomplete="current-password" <%= settingsReady?'':'disabled' %> required></label>
            <label>NEW PASSWORD<input type="password" name="newPassword" minlength="10" maxlength="128" autocomplete="new-password" <%= settingsReady?'':'disabled' %> required></label>
            <label>CONFIRM NEW PASSWORD<input type="password" name="confirmPassword" minlength="10" maxlength="128" autocomplete="new-password" <%= settingsReady?'':'disabled' %> required></label>
            <p class="micro">Use 10–128 characters (at most 72 UTF-8 bytes). Changing your password renews this browser's session; other signed-in sessions remain active.</p>
            <button type="submit" class="outline" <%= settingsReady?'':'disabled' %>>CHANGE PASSWORD</button>
          </form>
        </section>
        <section class="panel">
          <div class="section-heading"><span>RULES &amp; DATA</span></div>
          <p class="muted small">Manage your personal checklist in the Rules tab. Download your journal using CSV export. Notion synchronization is not connected yet.</p>
          <div class="actions">
            <a class="outline" href="#rules" data-tab-target="rules">MANAGE RULES</a>
            <a class="outline" href="/export">EXPORT MY JOURNAL</a>
          </div>
        </section>
      </section>

      <footer>
        DISCIPLINE · MY RULES. MY EDGE.<br>
        <span>Personal discipline tool, not a broker-level trading lock.</span>
      </footer>
    </main>
    <script id="trade-data" type="application/json"><%- JSON.stringify(trades.map(t => ({id: String(t._id), date: dayKey(t.createdAt, user.timezone), createdAt: t.createdAt.toISOString(), account: t.account || '', session: t.session || '', checklistCompleted: t.checklistCompleted ?? null, planDeviationReason: t.planDeviationReason || '', instrument: t.instrument, side: t.side, strategy: t.strategy || '', outcome: t.outcome, pnl: t.pnl, currency: t.currency || 'USD', emotion: t.emotion, followedPlan: t.followedPlan, notes: t.notes, hasImage: Boolean(t.imageId)}))).replace(/</g, '\\u003c') %></script>
  </body>
</html>
