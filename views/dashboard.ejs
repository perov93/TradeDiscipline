<!doctype html>
<%
  const settingsReady=typeof preferencesFor==='function';
  const preferences=settingsReady?preferencesFor(user):{
    defaultTab:'trading',defaultCurrency:'USD',calendarCurrency:'USD',analysisRange:'month',
    showWorldClocks:true,showForexHours:true,showNyReminder:true,showEconomicCalendar:true,showMotivationalMessage:true
  };

  /* ---- P&L helpers: + is always green, - is always red ---- */
  const fmtPnl=(n,c)=>{
    const v=Number(n)||0;
    const sign=v>0?'+':v<0?'−':'';
    return sign+Math.abs(v).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})+' '+(c||'USD');
  };
  const pnlClass=n=>(Number(n)||0)>0?'pnl-pos':(Number(n)||0)<0?'pnl-neg':'';

  /* ---- Today's numbers for the new cards ---- */
  const todayTotals={};
  todays.forEach(t=>{ const c=t.currency||'USD'; todayTotals[c]=(todayTotals[c]||0)+(Number(t.pnl)||0); });
  const todayTotalEntries=Object.entries(todayTotals);
  const tradesLeft=Math.max(0,limits.maxTrades-todays.length);
  const lossesLeft=Math.max(0,limits.maxLosses-losses);
  const recentTrades=[...trades].sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).slice(0,5);
  const recentTradeDays=new Map();
  const recentTradeTotals=new Map();
  const addTradeTotal=(totals,t)=>{
    const currency=t.currency||'USD';
    totals.set(currency,(totals.get(currency)||0)+(Number(t.pnl)||0));
  };
  recentTrades.forEach(t=>{
    const date=dayKey(t.createdAt,user.timezone);
    if(!recentTradeDays.has(date))recentTradeDays.set(date,{trades:[],totals:new Map()});
    const day=recentTradeDays.get(date);
    day.trades.push(t);
    addTradeTotal(day.totals,t);
    addTradeTotal(recentTradeTotals,t);
  });
  const recentDayFormat=new Intl.DateTimeFormat('en-GB',{timeZone:'UTC',weekday:'short',day:'numeric',month:'short'});
  const recapDateFormat=new Intl.DateTimeFormat('en-GB',{timeZone:'UTC',day:'numeric',month:'short'});
  const activeRulesCount=rules.filter(r=>r.active).length;
  const checkedActive=active.filter(r=>checks.includes(String(r._id))).length;
  const noSetupRecords=typeof noSetupEntries==='undefined'?[]:noSetupEntries;
  const sessionWhenFormat=new Intl.DateTimeFormat('en-GB',{weekday:'short',hour:'2-digit',minute:'2-digit',hourCycle:'h23',timeZone:user.timezone});
  let closedMarketRecap=null;
  if(typeof marketClosed!=='undefined'&&marketClosed){
    const dayMs=86400000;
    const accountDay=new Date(`${today}T00:00:00Z`);
    const weekday=accountDay.getUTCDay();
    const mondayOffset=(weekday+6)%7;
    const weekStart=new Date(accountDay.getTime()-(mondayOffset+(weekday>=1&&weekday<=5?7:0))*dayMs);
    const weekEnd=new Date(weekStart.getTime()+6*dayMs);
    const start=weekStart.toISOString().slice(0,10);
    const end=weekEnd.toISOString().slice(0,10);
    const items=trades.filter(t=>{
      const date=dayKey(t.createdAt,user.timezone);
      return date>=start&&date<=end&&date<=today;
    });
    const totals=new Map();
    items.forEach(t=>addTradeTotal(totals,t));
    const wins=items.filter(t=>t.outcome==='WIN').length;
    const losses=items.filter(t=>t.outcome==='LOSS').length;
    const knownPlan=items.filter(t=>typeof t.followedPlan==='boolean');
    closedMarketRecap={
      start,end,items,totals,wins,losses,
      winRate:wins+losses?`${Math.round(wins/(wins+losses)*100)}%`:'—',
      planRate:knownPlan.length?`${Math.round(knownPlan.filter(t=>t.followedPlan).length/knownPlan.length*100)}%`:'—',
      knownPlan:knownPlan.length,
      latest:recentTrades[0]
    };
  }
%>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#060608">
    <title>DISCIPLINE / My Rules. My Edge.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1">
    <link rel="stylesheet" href="/style.css?v=20261114-15">
    <script src="/app.js?v=20261114-11" defer></script>
    <script src="/calendar-ui.js?v=2" defer></script>
  </head>
  <body>
    <main class="app" data-default-tab="<%= preferences.defaultTab %>">
      <header class="top">
        <div class="brand">
          <div class="brandmark">D<span>.</span></div>
          <div>
            <div class="eyebrow">TRADING DISCIPLINE</div>
            <div class="brandline">MY RULES. MY EDGE.</div>
          </div>
        </div>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="ghost">SIGN OUT</button>
        </form>
      </header>

      <% if (error) { %>
        <div class="notice danger"><%= error %></div>
      <% } %>
      <% if (typeof success!=='undefined' && success) { %>
        <div class="notice success" role="status"><%= success %></div>
      <% } %>

      <nav class="dashboard-tabs" role="tablist" aria-label="Dashboard sections">
        <a id="tab-trading" role="tab" aria-selected="true" href="#trading" data-tab-target="trading">TRADE</a>
        <a id="tab-journal" role="tab" aria-selected="false" href="#journal" data-tab-target="journal">JOURNAL</a>
        <a id="tab-calendar" role="tab" aria-selected="false" href="#calendar" data-tab-target="calendar">CALENDAR</a>
        <a id="tab-rules" role="tab" aria-selected="false" href="#rules" data-tab-target="rules">RULES</a>
        <a id="tab-settings" role="tab" aria-selected="false" href="#settings" data-tab-target="settings">SETTINGS</a>
      </nav>

      <section class="dashboard-tabpanel active" id="trading" role="tabpanel" aria-labelledby="tab-trading">
        <section class="hero">
          <div class="eyebrow">
            <span>TODAY'S STATUS</span>
            <span><%= today %></span>
            <span class="trade-status <%= locked ? 'status-locked' : cooldown ? 'status-cooldown' : marketClosed ? 'status-closed' : 'status-ready' %>"><%= locked ? 'LOCKED' : cooldown ? 'COOLDOWN' : marketClosed ? 'CLOSED' : 'READY' %></span>
          </div>
          <h1>SESSION CHECK-IN</h1>
          <p>Check your limits, market sessions, and plan before you trade.</p>
          <div class="status-strip">
            <div>
              <span>TRADES</span>
              <strong><%= todays.length %> / <%= limits.maxTrades %></strong>
            </div>
            <div>
              <span>LOSSES</span>
              <strong class="<%= losses ? 'red' : '' %>"><%= losses %> / <%= limits.maxLosses %></strong>
            </div>
            <div>
              <span>WINS</span>
              <strong class="<%= todays.some(t => t.outcome === 'WIN') ? 'green' : '' %>"><%= todays.filter(t => t.outcome === 'WIN').length %></strong>
            </div>
            <div>
              <span>TODAY P&amp;L</span>
              <% if (todayTotalEntries.length) { %>
                <% todayTotalEntries.forEach(([cur, val]) => { %>
                  <strong class="money <%= pnlClass(val) %>"><%= fmtPnl(val, cur) %></strong>
                <% }) %>
              <% } else { %>
                <strong>—</strong>
              <% } %>
            </div>
          </div>
        </section>
        <% if (preferences.showMotivationalMessage && preferences.motivationalMessage) { %>
          <aside class="motivation-panel" aria-label="Your personal motivation">
            <div>
              <span class="eyebrow">MOTIVATIONAL REMINDER</span>
              <p><%= preferences.motivationalMessage %></p>
            </div>
            <a href="#settings" class="tag" data-tab-target="settings">EDIT</a>
          </aside>
        <% } %>

        <h2 class="trade-group-heading">SESSION &amp; AVAILABILITY</h2>
        <div class="trading-overview-grid">
          <section class="panel timer-panel account-lock-panel session-card <%= locked ? 'locked-panel' : cooldown ? 'cooldown-panel' : marketClosed ? 'market-closed-panel' : '' %>">
            <div class="section-heading">
              <span><%= locked ? 'DAILY ACCOUNT LOCK' : cooldown ? 'TRADE COOLDOWN' : marketClosed ? 'MARKET CLOSED' : 'ACCOUNT STATUS' %></span>
              <span class="tag <%= locked ? 'tag-red' : cooldown || marketClosed ? 'tag-amber' : 'tag-green' %>"><%= locked ? 'LOCKED' : cooldown ? 'WAIT' : marketClosed ? 'CLOSED' : 'READY' %></span>
            </div>
            <% if (availableAtLabel) { %>
              <% if (cooldown && !locked) { %>
                <p class="account-lock-reason">Cooldown after a recorded loss.</p>
              <% } %>
              <div class="card-label"><%= futuresOpeningCountdown ? 'NEXT FUTURES OPEN IN' : 'UNLOCKS IN' %></div>
              <div class="timer-face session-countdown <%= !locked && (cooldown || marketClosed) ? 'amber' : '' %>" id="timer" data-countdown-style="units" data-until="<%= availableAt.toISOString() %>" data-countdown-label="<%= futuresOpeningCountdown ? 'the next futures opening' : 'trading is available' %>" aria-label="00 days, 00 hours, 00 minutes, 00 seconds"><span data-countdown-part>0</span><small>d</small><span data-countdown-part>00</span><small>h</small><span data-countdown-part>00</span><small>m</small><span data-countdown-part>00</span><small>s</small></div>
              <% if (marketClosed && !locked && !cooldown) { %>
                <p class="session-when"><b><%= sessionWhenFormat.format(availableAt) %></b> your time · <%= new Intl.DateTimeFormat('en-GB',{timeZone:'America/New_York',weekday:'short',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(availableAt) %> ET</p>
              <% } %>
              <% if (!marketClosed || locked || cooldown) { %>
              <div class="time-conversions">
                <% if (user.timezone === 'Europe/Sofia') { %>
                  <div class="time-conversion">
                    <span>Your account + Bulgaria · Europe/Sofia</span>
                    <strong><%= availableAtLabel %></strong>
                  </div>
                  <div class="time-conversion">
                    <span>New York</span>
                    <strong><%= availableAtNyLabel %></strong>
                  </div>
                <% } else { %>
                  <div class="time-conversion">
                    <span>Your account · <%= user.timezone %></span>
                    <strong><%= availableAtLabel %></strong>
                  </div>
                  <div class="time-conversion">
                    <span>New York</span>
                    <strong><%= availableAtNyLabel %></strong>
                  </div>
                  <div class="time-conversion">
                    <span>Bulgaria</span>
                    <strong><%= availableAtBulgariaLabel %></strong>
                  </div>
                <% } %>
              </div>
              <% } %>
            <% } else { %>
              <div>
                <div class="timer-face <%= marketClosed ? 'account-closed' : 'account-ready' %>"><%= marketClosed ? 'MARKET CLOSED' : 'READY TO TRADE' %></div>
                <p class="timer-hint">No lock or cooldown. Confirm your rules before the first entry.</p>
              </div>
              <div class="time-conversion checklist-summary">
                <div class="card-row"><span>CHECKLIST</span><div class="checklist-summary-value"><strong id="checklistProgressValue"><%= checkedActive %> of <%= active.length %></strong><a class="card-link" href="#trade">OPEN →</a></div></div>
                <div class="card-progress card-progress-segments" id="checklistProgress" role="progressbar" aria-label="Checklist progress" aria-valuemin="0" aria-valuemax="<%= Math.max(1, active.length) %>" aria-valuenow="<%= checkedActive %>">
                  <% active.forEach((rule, index) => { %><i class="<%= index < checkedActive ? 'is-filled' : '' %>"></i><% }) %>
                </div>
              </div>
            <% } %>
            <% if (closedMarketRecap) { %>
            <div class="closed-market-recap">
              <div class="card-row session-recap-heading">
                <span class="card-label">WEEKLY RECAP</span>
                <span class="session-recap-date" title="<%= closedMarketRecap.start %> – <%= closedMarketRecap.end %> · <%= user.timezone %>"><%= recapDateFormat.format(new Date(`${closedMarketRecap.start}T00:00:00Z`)) %> – <%= recapDateFormat.format(new Date(`${closedMarketRecap.end}T00:00:00Z`)) %></span>
                <a class="card-link" href="/?calendarDate=<%= closedMarketRecap.start %>#calendar">REVIEW →</a>
              </div>
              <div class="session-recap-stats">
                <div>
                  <span>P&amp;L</span>
                  <% if(closedMarketRecap.totals.size){ %>
                    <% [...closedMarketRecap.totals].sort(([a],[b])=>a.localeCompare(b)).forEach(([currency,total])=>{ %>
                      <strong class="<%= pnlClass(total) %>"><%= fmtPnl(total,currency) %></strong>
                    <% }) %>
                  <% }else{ %><strong>—</strong><% } %>
                </div>
                <div>
                  <span>TRADES</span>
                  <strong><%= closedMarketRecap.items.length %></strong>
                  <small>W / L / BE · <%= closedMarketRecap.wins %> / <%= closedMarketRecap.losses %> / <%= closedMarketRecap.items.filter(t=>t.outcome==='BREAKEVEN').length %></small>
                </div>
                <div>
                  <span>WIN RATE</span>
                  <strong><%= closedMarketRecap.winRate %></strong>
                </div>
                <div>
                  <span>PLAN</span>
                  <strong><%= closedMarketRecap.planRate %></strong>
                  <small>of <%= closedMarketRecap.knownPlan %> known</small>
                </div>
              </div>
              <p class="session-footnote"><%= closedMarketRecap.items.length ? 'Win rate excludes break-even; plan excludes unknown statuses.' : 'No trades recorded for this week.' %></p>
            </div>
            <div class="session-last-trade">
              <span class="visually-hidden">LAST RECORDED TRADE</span>
              <% if(closedMarketRecap.latest){ const t=closedMarketRecap.latest; const date=dayKey(t.createdAt,user.timezone); %>
                <a class="account-trade closed-market-last-trade" href="/?calendarDate=<%= encodeURIComponent(date) %>#calendar">
                  <span><%= t.instrument || 'Trade' %> <em class="<%= t.side==='BUY'?'pnl-pos':t.side==='SELL'?'pnl-neg':'' %>"><%= t.side || '' %></em><br><small><%= recentDayFormat.format(new Date(`${date}T00:00:00Z`)) %> · <%= t.tradeTime || timeKey(t.createdAt,user.timezone) %> · <%= t.outcome %></small></span>
                  <strong class="<%= pnlClass(t.pnl) %>"><%= fmtPnl(t.pnl,t.currency) %></strong>
                </a>
              <% }else{ %><strong>No trades recorded yet</strong><% } %>
            </div>
            <% }else{ %>
            <div class="time-conversions limits-left">
              <div class="time-conversion">
                <span>TRADES LEFT TODAY</span>
                <strong><%= tradesLeft %> of <%= limits.maxTrades %></strong>
                <div class="card-progress card-progress-segments" role="progressbar" aria-label="Trades left today" aria-valuemin="0" aria-valuemax="<%= limits.maxTrades %>" aria-valuenow="<%= tradesLeft %>"><% for (let i=0; i<limits.maxTrades; i++) { %><i class="<%= i < tradesLeft ? 'is-filled' : '' %>"></i><% } %></div>
              </div>
              <div class="time-conversion">
                <span>LOSSES LEFT BEFORE LOCK</span>
                <strong class="<%= lossesLeft === 0 ? 'pnl-neg' : '' %>"><%= lossesLeft %> of <%= limits.maxLosses %></strong>
                <div class="card-progress card-progress-segments" role="progressbar" aria-label="Losses left before lock" aria-valuemin="0" aria-valuemax="<%= limits.maxLosses %>" aria-valuenow="<%= lossesLeft %>"><% for (let i=0; i<limits.maxLosses; i++) { %><i class="<%= i < lossesLeft ? 'is-filled' : '' %>"></i><% } %></div>
              </div>
            </div>
            <div class="time-conversion account-today">
              <div class="card-row">
                <span class="card-label">TODAY</span>
                <div class="account-totals">
                  <% if (todayTotalEntries.length) { todayTotalEntries.forEach(([cur, val]) => { %>
                    <strong class="<%= pnlClass(val) %>"><%= fmtPnl(val, cur) %></strong>
                  <% }) } else { %><span>No trades recorded</span><% } %>
                </div>
              </div>
              <% if (todays.length) { %>
                <div class="account-trades">
                  <% [...todays].sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).forEach(t => { %>
                    <div class="account-trade"><span><%= t.instrument %> · <%= t.side %> <small><%= t.outcome %></small></span><strong class="<%= pnlClass(t.pnl) %>"><%= fmtPnl(t.pnl, t.currency) %></strong></div>
                  <% }) %>
                </div>
              <% } %>
            </div>
            <% } %>
          </section>

          <% if (preferences.showNyReminder) { %>
          <% const nyLive = nySession.phase && nySession.phase.startsWith('PRE-MARKET IS OPEN') ? 'premarket' : nySession.phase && nySession.phase.startsWith('REGULAR') ? 'regular' : ''; %>
          <section class="panel ny-session-panel session-card<%= nyLive ? ' is-' + nyLive : '' %>" id="nySessionPanel" aria-labelledby="nySessionTitle">
            <div class="section-heading">
              <span id="nySessionTitle">NEW YORK SESSION</span>
              <span class="tag ny-session-badge" id="nySessionBadge"><%= nyLive === 'premarket' ? 'PRE-MARKET OPEN' : nyLive === 'regular' ? 'NY SESSION OPEN' : 'US EQUITIES · ET' %></span>
            </div>
            <div class="ny-live-banner" id="nyLiveBanner" role="status"<%= nyLive ? '' : ' hidden' %>>
              <span class="ny-live-dot" aria-hidden="true"></span>
              <strong id="nyLiveLabel"><%= nyLive === 'regular' ? 'NY SESSION OPEN' : 'PRE-MARKET OPEN' %></strong>
              <span class="ny-live-countdown" id="nyLiveCountdown" role="timer" aria-live="off"></span>
            </div>
            <div class="ny-session-phase visually-hidden" id="nySessionPhase"><%= nySession.phase %></div>
            <div class="ny-session-milestone" id="nySessionMilestone">NEXT PRE-MARKET · 8:30 AM ET</div>
            <div class="timer-face ny-session-timer session-countdown" id="nySessionTimer" data-countdown-style="units" data-schedule="<%= encodeURIComponent(JSON.stringify(nySession.schedule)) %>" data-account-timezone="<%= user.timezone %>"><span data-countdown-part>0</span><small>d</small><span data-countdown-part>00</span><small>h</small><span data-countdown-part>00</span><small>m</small><span data-countdown-part>00</span><small>s</small></div>
            <p class="session-when" id="nySessionWhen"></p>
            <div class="ny-session-timeline" aria-label="New York time: pre-market 8:30 to 9:30 AM, regular session 9:30 AM to 4 PM">
              <div class="ny-timeline-track">
                <span class="ny-timeline-pre">PRE</span>
                <span class="ny-timeline-regular">REGULAR · 9:30–16:00 ET</span>
                <span class="ny-timeline-now" id="nySessionNow" hidden aria-hidden="true"></span>
              </div>
              <div class="ny-timeline-scale"><span>8:30</span><span>9:30</span><span>16:00 ET</span></div>
            </div>
            <div class="ny-session-times" id="nySessionTimes" aria-label="Session times in your account timezone">
              <div class="time-conversion"><span>PRE-MARKET</span><strong id="nyTimePremarket">—</strong><span id="nyDatePremarket"></span><span>8:30 ET</span></div>
              <div class="time-conversion"><span>NY OPEN</span><strong id="nyTimeOpen">—</strong><span id="nyDateOpen"></span><span>9:30 ET</span></div>
              <div class="time-conversion"><span>NY CLOSE</span><strong id="nyTimeClose">—</strong><span id="nyDateClose"></span><span>16:00 ET</span></div>
            </div>
            <p class="ny-session-note">Times in your account timezone (<%= user.timezone %>). Weekdays only; holidays not included.</p>
          </section>
          <% } %>
        </div>

        <h2 class="trade-group-heading">BEFORE YOU TRADE</h2>
        <div class="trading-work-grid">
          <section class="panel" id="trade">
            <div class="section-heading">
              <span>01 / PRE-TRADE CHECKLIST</span>
              <span class="tag" id="checklistCount"><%= checkedActive %> OF <%= active.length %></span>
            </div>
            <p class="muted small">Confirm each statement honestly before every trade.</p>
            <% if (locked || cooldown) { %>
              <%
                const checklistUnlockAt = typeof checklistAvailableAt !== 'undefined' ? checklistAvailableAt : availableAt;
                const checklistUnlockLabel = typeof checklistAvailableAtLabel !== 'undefined' ? checklistAvailableAtLabel : availableAtLabel;
              %>
              <div class="checklist-paused <%= locked ? 'paused-locked' : 'paused-cooldown' %>">
                <strong><%= locked ? 'CHECKLIST PAUSED · DAILY LOCK' : 'CHECKLIST PAUSED · COOLDOWN' %></strong>
                <span><%= locked ? lockReason : 'A recorded loss started a cooldown' %>. Checklist becomes available at <%= checklistUnlockLabel %> account time.</span>
                <% if (checklistUnlockAt) { %>
                  <div class="timer-face checklist-unlock-timer <%= cooldown && !locked ? 'amber' : '' %>" data-until="<%= checklistUnlockAt.toISOString() %>" data-countdown-label="the checklist is available" aria-label="Time until the checklist is available">0d 00h 00m 00s</div>
                <% } %>
                <small>The page refreshes automatically when the countdown ends. If it does not, refresh manually to continue.</small>
              </div>
            <% } else { %>
              <% if (checklistCompleted) { %>
                <div class="notice success">CHECKLIST COMPLETE. Record your outcome after the trade.</div>
              <% } %>
              <form method="post" action="/check" id="checklistForm">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <div class="checklist">
                  <% active.forEach((r, i) => { %>
                    <label class="rule">
                      <input type="checkbox" name="rules" value="<%= r._id %>" <%= checks.includes(String(r._id)) ? 'checked' : '' %>>
                      <span>
                        <strong><%= r.title %></strong>
                        <small><%= r.description || 'Follow this rule before entering.' %></small>
                      </span>
                    </label>
                  <% }) %>
                </div>
                <label class="field-label">CURRENT EMOTIONAL STATE
                  <select name="mood">
                    <option value="calm">Calm and focused</option>
                    <option value="fomo">FOMO / impatient</option>
                    <option value="revenge">Angry / revenge</option>
                  </select>
                </label>
                <button class="primary full" <%= !active.length ? 'disabled' : '' %>>COMPLETE PRE-TRADE CHECK</button>
              </form>
              <% if (checklistCompleted) { %>
                <form method="post" action="/check/reset" class="checklist-reset-form" data-confirm="Reset the completed checklist? You will need to complete it again before your next trade.">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button type="submit" class="textbutton checklist-reset-button">RESET CHECKLIST · NO TRADE</button>
                </form>
              <% } %>
            <% } %>
          </section>

          <div class="trade-sidecards">
            <section class="panel">
              <div class="section-heading">
                <span>02 / RECORD OUTCOME</span>
              </div>
              <p class="muted small">Record a completed trade. Losses start a cooldown; your daily limits can lock trading.</p>
              <div class="actions">
                <a href="#journal" class="outline outcome-win" data-record-outcome="WIN">+ RECORD WIN</a>
                <a href="#journal" class="outline outcome-loss" data-record-outcome="LOSS">− RECORD LOSS</a>
              </div>
            </section>
            <section class="stop-panel <%= locked ? 'locked-panel' : '' %>">
              <div>
                <div class="eyebrow">EMERGENCY CONTROL</div>
                <h2>STOP TRADING.</h2>
                <p>Protect your account. End your session for today.</p>
              </div>
              <form method="post" action="/stop" data-confirm="Lock trading for the rest of today?">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="stop" <%= locked ? 'disabled' : '' %>>LOCK TODAY</button>
              </form>
            </section>
          </div>
        </div>

        <% if (preferences.showWorldClocks || preferences.showForexHours || preferences.showEconomicCalendar) { %>
        <h2 class="trade-group-heading">MARKETS &amp; CLOCKS</h2>
        <% } %>
      <% if (preferences.showWorldClocks) { %>
      <section class="panel world-clock-panel" aria-label="Current time in your account timezone and market timezones">
        <div class="world-clock-heading">
          <strong>WORLD CLOCKS</strong>
          <span>LIVE · 24-HOUR TIME</span>
        </div>
        <div class="world-clock-grid">
          <article class="world-clock-card" data-world-clock data-timezone="<%= user.timezone %>">
            <span class="world-clock-label"><%= user.timezone === 'Europe/Sofia' ? 'YOUR TIME · BULGARIA' : 'YOUR ACCOUNT TIME' %></span>
            <time class="world-clock-time">--:--:--</time>
            <span class="world-clock-date"><%= user.timezone %></span>
          </article>
