        <% if (preferences.showForexHours) { %>
        <section class="panel fx-session-panel" aria-labelledby="fxSessionTitle">
          <div class="section-heading">
            <span id="fxSessionTitle">FOREX MARKET HOURS</span>
            <span class="tag" id="fxSessionSummary">SOFIA TIME · UPDATING</span>
          </div>
          <div class="fx-session-grid" id="fxSessionGrid" aria-live="polite">
            <article class="fx-session-card" data-session="sydney">
              <div class="fx-session-card-heading"><strong>Sydney</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">08:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">17:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
            <article class="fx-session-card" data-session="tokyo">
              <div class="fx-session-card-heading"><strong>Tokyo</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">09:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">18:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
            <article class="fx-session-card" data-session="london">
              <div class="fx-session-card-heading"><strong>London</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">08:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">17:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
            <article class="fx-session-card" data-session="new-york">
              <div class="fx-session-card-heading"><strong>New York</strong><span class="fx-session-state">--</span></div>
              <div class="fx-session-countdown" role="timer" aria-live="off">UPDATING</div>
              <div class="fx-session-schedule">
                <span>OPENS <strong class="fx-session-open">08:00</strong></span>
                <span>CLOSES <strong class="fx-session-close">17:00</strong></span>
              </div>
              <div class="fx-session-progress"><span></span></div>
            </article>
          </div>
          <p class="micro">Indicative regional session times are shown in Sofia time (Europe/Sofia), using a 24-hour clock. Active cards show the current session; closed cards show the next weekday session. Timers count down to that session's closing or opening. Weekdays follow each market's local timezone, so Sydney's Monday session can begin on Sunday in Bulgaria. Broker trading hours may differ; market holidays are not included. Sessions, overlaps and timers update live; daylight-saving changes are automatic.</p>
        </section>
        <% } %>

        <% if (preferences.showEconomicCalendar) { %>
        <section class="panel economic-calendar-panel" aria-labelledby="economicCalendarTitle">
          <div class="section-heading">
            <span id="economicCalendarTitle">ECONOMIC CALENDAR</span>
            <span class="tag">US · HIGH IMPACT</span>
          </div>
          <div class="economic-calendar-frame">
            <tv-economic-calendar countries="us" high-importance-only theme="dark"></tv-economic-calendar>
          </div>
          <p class="micro">Economic events are provided by TradingView. If the calendar does not appear, check your connection or browser content blockers.</p>
          <script type="module" src="https://widgets.tradingview-widget.com/w/en/tv-economic-calendar.js"></script>
        </section>
        <% } %>

      </section>

      <section class="dashboard-tabpanel" id="rules" role="tabpanel" aria-labelledby="tab-rules" hidden>
        <section class="panel">
          <div class="section-heading">
            <span>MY TRADING RULES</span>
            <span class="tag"><%= activeRulesCount %> ACTIVE · <%= rules.length %> TOTAL</span>
          </div>
          <p class="muted small">Manage your trading rules. Only active rules appear in your pre-trade checklist.</p>
          <div class="rule-manager-list">
            <% rules.forEach((r, i) => { %>
              <div class="rule-manager-row">
                <div class="rule-manager-number"><%= String(i + 1).padStart(2, '0') %></div>
                <div class="rule-manager-copy">
                  <strong><%= r.title %></strong>
                  <small><%= r.active ? 'ACTIVE' : 'INACTIVE' %><% if (r.description) { %> · <%= r.description %><% } %></small>
                </div>
                <button type="button" class="outline rule-edit-trigger" data-id="<%= r._id %>" data-title="<%= r.title %>" data-description="<%= r.description || '' %>" data-active="<%= r.active ? 'true' : 'false' %>" aria-label="Edit rule <%= r.title %>">EDIT</button>
              </div>
            <% }) %>
          </div>
          <button type="button" class="primary full" id="addRuleBtn">+ ADD NEW RULE</button>
        </section>
      </section>

      <dialog id="ruleDialog" class="rule-dialog" aria-labelledby="ruleDialogTitle">
        <div class="rule-dialog-head">
          <div>
            <div class="eyebrow">DISCIPLINE / RULE MANAGER</div>
            <h2 id="ruleDialogTitle">EDIT RULE</h2>
          </div>
          <form method="dialog" class="dialog-close-form">
            <button type="submit" class="rule-dialog-close ghost" id="closeRuleDialog" aria-label="Close dialog">✕</button>
          </form>
        </div>
        <form method="post" id="ruleEditor" class="journal-form" action="/rules">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>RULE TITLE<input name="title" id="ruleTitle" maxlength="140" required placeholder="I don't chase trades"></label>
          <label>DESCRIPTION<textarea name="description" id="ruleDescription" maxlength="500" rows="4" placeholder="Why this rule matters"></textarea></label>
          <label class="inline-check"><input type="checkbox" id="ruleActive" name="active" checked> RULE IS ACTIVE</label>
          <button type="submit" class="primary full" id="ruleSave">SAVE RULE</button>
        </form>
        <form method="post" id="ruleDeleteForm" action="/rules" data-confirm="Permanently delete this trading rule?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="textbutton danger-text">DELETE THIS RULE</button>
        </form>
      </dialog>

      <section class="dashboard-tabpanel" id="journal" role="tabpanel" aria-labelledby="tab-journal" hidden>
        <div class="journal-grid">
        <section class="panel">
          <div class="section-heading">
            <span>04 / TRADING JOURNAL</span>
            <a href="/export" class="tag">EXPORT CSV</a>
          </div>
          <p class="muted small">Add a trade record here. Choose a session if you’re logging later, or leave it on automatic detection. Browse, preview, and edit saved records in the calendar.</p>
          <form method="post" action="/trades" id="journalTradeForm" class="journal-form" enctype="multipart/form-data" data-image-upload data-plan-follow-up data-outcome-pnl>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (!checklistCompleted) { %>
              <p class="notice warning">No completed checklist is recorded today. Did you follow your plan anyway? If not, explain why before saving.</p>
            <% } %>
            <label>TRADING ACCOUNT<input name="account" maxlength="80" placeholder="e.g. Personal, FTMO 100K"></label>
            <label>ACCOUNTS TRADED<input name="accountCount" type="number" min="1" max="100" step="1" value="5" required></label>
            <div class="form-row">
              <label>TRADING SESSION
                <select name="session">
                  <% sessionChoices.forEach(choice => { %>
                    <option value="<%= choice %>" <%= choice === 'auto' ? 'selected' : '' %>><%= choice === 'auto' ? 'Automatic · based on save time' : choice %></option>
                  <% }) %>
                </select>
              </label>
              <label>TRADE ENTRY TIME (<%= user.timezone %>)<input type="time" name="tradeTime" value="<%= timeKey(new Date(), user.timezone) %>" required></label>
            </div>
            <div class="form-row">
              <label>INSTRUMENT<input name="instrument" maxlength="40" placeholder="XAUUSD"></label>
              <label>DIRECTION
                <select name="side">
                  <option value="">Not specified</option>
                  <option>BUY</option>
                  <option>SELL</option>
                </select>
              </label>
            </div>
            <div class="form-row">
              <label>OUTCOME
                <select name="outcome" id="journalOutcome" required>
                  <option value="" selected disabled>Choose an outcome</option>
                  <option>WIN</option>
                  <option>LOSS</option>
                  <option>BREAKEVEN</option>
                </select>
              </label>
              <label>COMBINED P&amp;L<input name="pnl" type="number" step="0.01" value="0" required></label>
            </div>
            <p class="micro">Combined result across accounts; approximate per-account P&amp;L assumes an even split.</p>
            <p class="micro outcome-pnl-warning" data-outcome-pnl-warning role="status" hidden></p>
            <label>CURRENCY CODE<input name="currency" maxlength="3" minlength="3" pattern="[A-Za-z]{3}" value="<%= preferences.defaultCurrency %>" required autocomplete="off" placeholder="USD"></label>
            <label>STRATEGY<input name="strategy" maxlength="120" placeholder="e.g. NY open breakout, pullback"></label>
            <label>EMOTION
              <select name="emotion">
                <option value="calm">Calm</option>
                <option value="fomo">FOMO</option>
                <option value="revenge">Revenge impulse</option>
                <option value="other">Other</option>
              </select>
            </label>
            <label class="inline-check"><input type="checkbox" name="followedPlan" id="journalFollowedPlan" <%= checklistCompleted ? 'checked' : '' %>> YES, I FOLLOWED MY PLAN</label>
            <label id="journalPlanDeviationField" data-plan-deviation <%= checklistCompleted ? 'hidden' : '' %>>WHY DIDN'T YOU FOLLOW YOUR PLAN?
              <textarea name="planDeviationReason" maxlength="500" rows="2" <%= checklistCompleted ? '' : 'required' %> placeholder="Briefly explain what happened."></textarea>
            </label>
            <label>LESSON / NOTES<textarea name="notes" maxlength="3000" rows="3" placeholder="What happened? What did I learn?"></textarea></label>
            <label>TRADINGVIEW SNAPSHOT LINK (OPTIONAL)
              <input type="url" name="tradingViewUrl" maxlength="2048" placeholder="https://www.tradingview.com/x/..." data-tradingview-input autocomplete="url">
            </label>
            <p class="micro">Paste a public TradingView snapshot link to preview its chart image. The screenshot loads directly from TradingView.</p>
            <div class="upload-preview tradingview-preview" data-tradingview-preview hidden></div>
            <label>TRADE IMAGES (OPTIONAL · UP TO 10 · JPEG, PNG OR WEBP · MAX 5 MB EACH)<input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple data-image-input></label>
            <div class="upload-preview" data-upload-preview hidden></div>
            <p class="notice danger upload-error" role="alert" hidden></p>
            <button type="submit" class="primary">SAVE TRADE</button>
          </form>
          <details class="no-setup-create">
            <summary>NO SETUP PRESENTED · ADD ENTRY</summary>
            <p class="micro">Record a day without a trade. These entries do not affect trade limits or performance statistics and are not included in the trade CSV.</p>
            <form method="post" action="/no-setup" class="journal-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <label>DATE<input type="date" name="date" value="<%= today %>" required></label>
              <label>NOTES (OPTIONAL)<textarea name="notes" maxlength="3000" rows="3" placeholder="What did you observe?"></textarea></label>
              <button type="submit" class="outline">SAVE NO-SETUP ENTRY</button>
            </form>
          </details>
        </section>

        <section class="panel recent-trades" aria-labelledby="recentTradesTitle">
          <div class="section-heading">
            <span id="recentTradesTitle">RECENT TRADES</span>
            <span class="tag">LAST <%= recentTrades.length %></span>
          </div>
          <% if (!recentTrades.length) { %>
            <p class="empty">No trades recorded yet. Your latest five will appear here.</p>
          <% } else { %>
            <div class="recent-trades-net">
              <span>NET P&amp;L</span>
              <div class="recent-trades-totals">
                <% [...recentTradeTotals].sort(([a],[b])=>a.localeCompare(b)).forEach(([currency,total])=>{ %>
                  <strong class="<%= pnlClass(total) %>"><%= fmtPnl(total,currency) %></strong>
                <% }) %>
              </div>
            </div>
            <% recentTradeDays.forEach((day,date)=>{ %>
              <div class="recent-trade-group">
                <div class="recent-trade-day">
                  <span><%= recentDayFormat.format(new Date(`${date}T00:00:00Z`)).toUpperCase() %></span>
                  <div class="recent-trade-day-totals">
                    <% [...day.totals].sort(([a],[b])=>a.localeCompare(b)).forEach(([currency,total])=>{ %>
                      <b class="<%= pnlClass(total) %>"><%= fmtPnl(total,currency) %></b>
                    <% }) %>
                  </div>
                </div>
                <% day.trades.forEach(t=>{ %>
                  <a class="recent-trade-row" href="/?calendarDate=<%= encodeURIComponent(date) %>#calendar" aria-label="View calendar records for <%= date %>: <%= t.instrument || 'Trade' %>">
                    <span class="recent-trade-time"><%= t.tradeTime || timeKey(t.createdAt,user.timezone) %></span>
                    <span class="recent-trade-name">
                      <%= t.instrument || 'Trade' %><% if(t.side){ %><span class="recent-trade-side <%= t.side==='SELL'?'pnl-neg':'pnl-pos' %>"><%= t.side %></span><% } %>
                      <% if(t.followedPlan===false){ %><span class="recent-trade-sub pnl-neg">Plan broken</span><% }else if(t.strategy){ %><span class="recent-trade-sub"><%= t.strategy %></span><% } %>
                    </span>
                    <span class="recent-trade-amount <%= pnlClass(t.pnl) %>"><%= fmtPnl(t.pnl,t.currency) %></span>
                  </a>
                <% }) %>
              </div>
            <% }) %>
            <a class="recent-trades-more" href="#calendar">OPEN CALENDAR TO EDIT →</a>
          <% } %>
          <div class="no-setup-records">
            <div class="section-heading"><span>NO-SETUP ENTRIES</span><span class="tag"><%= noSetupRecords.length %></span></div>
            <% if (!noSetupRecords.length) { %>
              <p class="empty">No no-setup entries yet.</p>
            <% } else { %>
              <div class="journal-list">
                <% noSetupRecords.forEach(entry => { %>
                  <article class="journal-item">
                    <div class="journal-item-head"><strong>NO SETUP PRESENTED</strong><strong><%= entry.date %></strong></div>
                    <% if (entry.notes) { %><p class="no-setup-notes"><%= entry.notes %></p><% } %>
                    <details>
                      <summary>EDIT ENTRY</summary>
                      <form method="post" action="/no-setup/<%= entry._id %>/edit" class="journal-form">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <input type="hidden" name="returnTo" value="journal">
                        <label>DATE<input type="date" name="date" value="<%= entry.date %>" required></label>
                        <label>NOTES (OPTIONAL)<textarea name="notes" maxlength="3000" rows="3"><%= entry.notes %></textarea></label>
                        <button type="submit" class="outline">SAVE CHANGES</button>
                      </form>
                    </details>
                    <form method="post" action="/no-setup/<%= entry._id %>/delete" data-confirm="Delete this no-setup entry?">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <input type="hidden" name="returnTo" value="journal">
                      <button type="submit" class="textbutton danger-text">DELETE</button>
                    </form>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>
        </div>
      </section>

      <dialog id="tradeDialog" class="rule-dialog trade-dialog" aria-labelledby="tradeDialogTitle">
        <div class="rule-dialog-head">
          <div>
            <div class="eyebrow">JOURNAL / CALENDAR RECORD</div>
            <h2 id="tradeDialogTitle">EDIT TRADE</h2>
            <p id="tradeEditDate" class="micro"></p>
          </div>
          <form method="dialog" class="dialog-close-form">
            <button type="submit" class="rule-dialog-close ghost" id="closeTradeDialog" aria-label="Close dialog">✕</button>
          </form>
        </div>
        <form method="post" id="tradeEditor" class="journal-form" action="/trades" enctype="multipart/form-data" data-image-upload data-plan-follow-up data-outcome-pnl>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="returnTo" id="tradeReturnTo" value="calendar">
          <input type="hidden" name="returnDate" id="tradeReturnDate">
          <label>TRADING ACCOUNT<input name="account" id="tradeAccount" maxlength="80"></label>
