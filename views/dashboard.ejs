            <span class="world-clock-date">America/New_York</span>
          </article>
          <% if (user.timezone !== 'Europe/Sofia') { %>
            <article class="world-clock-card" data-world-clock data-timezone="Europe/Sofia">
              <span class="world-clock-label">BULGARIA</span>
              <time class="world-clock-time">--:--:--</time>
              <span class="world-clock-date">Europe/Sofia</span>
            </article>
          <% } %>
        </div>
