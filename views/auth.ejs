<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080808"><title>DISCIPLINE · <%= register?'Register':'Login' %></title><link rel="stylesheet" href="/style.css"></head><body class="auth-body"><main class="auth-card"><div class="mark">D<span>.</span></div><p class="eyebrow">THE TRADING DISCIPLINE SYSTEM</p><h1><%= register?'Create your account':'Welcome back' %></h1><p class="muted">Control the process. Respect the rules.</p><% if(error){ %><div class="notice danger"><%= error %></div><% } %><form action="<%= register?'/register':'/login' %>" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(register){ %><label>Name<input name="name" maxlength="80" autocomplete="name" required></label><% } %><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" minlength="10" autocomplete="<%= register?'new-password':'current-password' %>" required></label><button class="primary" type="submit"><%= register?'Create account':'Sign in' %></button></form><p class="muted small center"><%= register?'Already have an account?':'New here?' %> <a href="<%= register?'/login':'/register' %>"><%= register?'Sign in':'Register' %></a></p><% if(!register){ %><aside class="dedication"><span class="eyebrow">A DEDICATION</span><p>For my wife, Desislava Vasileva: thank you for your love, patience, and support. This work is dedicated to you, with all my love.</p></aside><% } %></main></body></html>
